;; The data of the game: files read with `X.load`.

pin data = [
    root = "data",          ;; where the converted data is
]

;; A data file, as the value written in it. A path that starts with `/`
;; is relative to the data of the game (`/levels/world1/x.stl`); any
;; other is a file as it is (`tst/levels/empty.stl`).
func data.load (path) {
    val full = if string.sub(path,0,0) == "/" => data.root ++ path ++ ".atm" => path ++ ".atm"
    pin f = io.open(full) || throw :tux.data, "cannot open " ++ full
    val src = io.read(f, :all)
    io.close(f)
    X.load(src)
}

;; The fields of the tiles of a tileset, by id (`TileSetParser`):
;;      attrs   the attributes: solid, unisolid, slope, ice, water, ...
;;      datas   the kind of slope, or the directions of a worldmap tile
;;      objs    the object that a tile becomes when a level loads, as
;;              [name, data] (a coin, a bonus block, a brick)
;; A tile with no entry has no attributes.

pin TILE = [
    SOLID = 0x0001, UNISOLID = 0x0002, BRICK = 0x0004, GOAL = 0x0008,
    SLOPE = 0x0010, FULLBOX  = 0x0020, COIN  = 0x0040,
    ICE   = 0x0100, WATER    = 0x0200, HURTS = 0x0400, FIRE = 0x0800,
    WALLJUMP = 0x1000,
    NORTH = 0x0001, SOUTH = 0x0002, EAST = 0x0004, WEST = 0x0008,
    STOP  = 0x0010,
]

func data.tileset (path) {
    val src = data.load(path)
    val ts = [attrs=[], datas=[], objs=[], max=0]
    val func add (id, a, d, name, odata) {
        if ts.attrs@(id) == nil {       ;; the first definition stays
            set ts.attrs@(id) = a
            set ts.datas@(id) = d
            if name {
                set ts.objs@(id) = [name, odata]
            }
            if id > ts.max {
                set ts.max = id
            }
        }
    }
    loop _,t in src {
        if type(t) != :table {
            ;; a field of the tileset
        } else {
            match t.tag {
                :tile => {
                    var a = 0
                    if t.solid    { set a = a | TILE.SOLID }
                    if t.unisolid { set a = a | TILE.UNISOLID | TILE.SOLID }
                    if t.brick    { set a = a | TILE.BRICK }
                    if t.ice      { set a = a | TILE.ICE }
                    if t.water    { set a = a | TILE.WATER }
                    if t.hurts    { set a = a | TILE.HURTS }
                    if t.fire     { set a = a | TILE.FIRE }
                    if t.walljump { set a = a | TILE.WALLJUMP }
                    if t.fullbox  { set a = a | TILE.FULLBOX }
                    if t.coin     { set a = a | TILE.COIN }
                    if t.goal     { set a = a | TILE.GOAL }
                    var d = 0
                    if t.north { set d = d | TILE.NORTH }
                    if t.south { set d = d | TILE.SOUTH }
                    if t.west  { set d = d | TILE.WEST }
                    if t.east  { set d = d | TILE.EAST }
                    if t.stop  { set d = d | TILE.STOP }
                    if t.data != nil {
                        set d = t.data
                    }
                    if t.slope_type != nil {
                        set d = t.slope_type
                        set a = a | TILE.SOLID | TILE.SLOPE
                    }
                    add(t.id, a, d, t.object_name, t.object_data)
                }
                :tiles => {
                    val off = t.offset || 0
                    assert(#t.ids == t.width * t.height, "tiles: ids and size differ")
                    loop i,id in t.ids {
                        if id != 0 {
                            add(id + off,
                                if t.attributes => t.attributes@i => 0,
                                if t.datas      => t.datas@i      => 0)
                        }
                    }
                }
            }
        }
    }
    ts
}
