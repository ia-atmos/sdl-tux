;; The badguys: `BadGuy` and `WalkingBadguy` of the original, and the
;; walking ones (`SnowBall`, `SmartBall`), as tasks in the pool of the
;; objects of a sector.
;;
;; A badguy is a task with its state in the table `b`. As in the original,
;; it is updated at each step (`:update`), and it receives the collisions
;; of its object: with the solids (`:solid`), with the tiles (`:tile`),
;; and with the other objects (`:hit`), whose response is `pub.resp`. Its
;; state (`BadGuy::State`) goes to the trace (the lines `E`), and the
;; lines `B` of the trace are printed by C (game/tux.h, `tg_bg_trace`).
;;
;; What asks for the collision system of the sector is in C (game/tux.h,
;; `tg_bg_*`): whether the badguy is off screen, in water, over a ledge
;; (`might_fall`, by raycasts).
;;
;; Not done yet: frozen and burning badguys (ice and fire bullets),
;; glinting badguys, grabbed ones, wind, ice physics on ice tiles, and the
;; dead script.

;; `BadGuy::State`
pin BG = [INIT=0, INACTIVE=1, ACTIVE=2, SQUISHED=3, FADING=4, FALLING=5]

;; The directions of the original (`Direction`).
pin DIR = [AUTO=`:number TX_DIR_AUTO`, LEFT=`:number TX_DIR_LEFT`, RIGHT=`:number TX_DIR_RIGHT`,
           UP=`:number TX_DIR_UP`, DOWN=`:number TX_DIR_DOWN`]
pin DIRS = [auto=DIR.AUTO, left=DIR.LEFT, right=DIR.RIGHT]
pin DIR_NAME = [@(DIR.LEFT)="left", @(DIR.RIGHT)="right"]

;; The badguys, by the name of their class: their kind (a walking badguy,
;; a jumpy, a bouncing or a flying snowball, an ice block, a bomb, or a
;; stalactite), their sprite; for the walking ones, their speed, and how far they let themselves fall from a ledge
;; (`max_drop_height`, -1: they always fall), whether the player squishes
;; them (`collision_squished`), and whether they sleep until the player
;; comes near (`SSpiky`).
pin BADGUYS = [
    snowball  = [kind=:walker, name="snowball", sprite="images/creatures/snowball/snowball.sprite",
                 walk_speed=80, max_drop=-1, squish=true],
    smartball = [kind=:walker, name="smartball", sprite="images/creatures/snowball/smart-snowball.sprite",
                 walk_speed=80, max_drop=16, squish=true],
    spiky     = [kind=:walker, name="spiky", sprite="images/creatures/spiky/spiky.sprite",
                 walk_speed=80, max_drop=600, squish=false, freezable=true],
    sspiky    = [kind=:walker, name="sspiky", sprite="images/creatures/spiky/sleepingspiky.sprite",
                 walk_speed=80, max_drop=600, squish=false, sleeps=true, freezable=true],
    jumpy     = [kind=:jumpy, name="jumpy", sprite="images/creatures/jumpy/snowjumpy.sprite",
                 squish=false, freezable=true],
    bouncingsnowball = [kind=:bouncing, name="bouncingsnowball",
                 sprite="images/creatures/bouncing_snowball/bouncing_snowball.sprite", squish=true],
    flyingsnowball = [kind=:flying, name="flyingsnowball",
                 sprite="images/creatures/flying_snowball/flying_snowball.sprite", squish=true],
    mriceblock = [kind=:iceblock, name="mriceblock", sprite="images/creatures/iceblock/iceblock.sprite",
                 walk_speed=80, max_drop=-1, squish=false],
    smartblock = [kind=:iceblock, name="smartblock", sprite="images/creatures/iceblock/smart_block.sprite",
                 walk_speed=80, max_drop=16, squish=false],
    mrbomb     = [kind=:bomb, name="mrbomb", sprite="images/creatures/mr_bomb/mr_bomb.sprite",
                 walk_speed=80, max_drop=16, squish=false, freezable=true],
    stalactite = [kind=:stalactite, name="stalactite", sprite="images/creatures/stalactite/stalactite_ice.sprite",
                 squish=false, layer=-1],
]

;; The uid of an object of a sector, as the original numbers them
;; (`UIDGenerator`): the sector of the n-th life has the generator 2n-1
;; (each restart makes two, as seen in the official game),
;; and its objects are numbered in the order of the level, from 4 on
;; (`k` is the position of the object in the sector, from 0).
func uid_of (life, k) {
    (((2 * life.n) - 1) * 16777216) + k + 4
}

;; An explosion (`Explosion`), at `x`, `y` (its middle): it explodes at its
;; first update (it shakes the camera, throws particles, pushes the
;; player and the walking badguys, shakes and opens the blocks near), kills
;; what it touches in the first frames of its sprite, and fades.
task Explosion (life, x, y, push_strength) {
    val sprite = "images/objects/explosion/explosion.sprite"
    val box = sprite_box(sprite, "default")
    val id = obj_new(x, y, box@2, box@3, COL.MOVING, KIND.OTHER)
    `tg_explosion_center($id.u.i);`
    val l = look_new(sprite, x, y, LAYER_OBJECTS + 40)
    `tg_looks[$l.u.i].obj = $id.u.i;`
    set pub = [resp=HIT.ABORT, kind=:explosion]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
        `tg_look_del($l.u.i);`
    }
    pin a = anim_new()
    anim_set(a, sprite, "default", -1)
    set a.name = "default"
    var st = :waiting
    pin fading = timer()

    ;; `Explosion::explode`
    val func explode () {
        set st = :exploding
        `tc_shake(&tg_cam, .1f, 0.f, 10.f);`
        set a.loops = 1                         ;; `set_animation_loops(1)`
        `tg_looks[$l.u.i].angle = tr_randf(&tg_grand, 0, 360);`
        `tg_look_action_loops($l.u.i, "default", 1);`
        ```
        {
            TxObj* o = tg_objs[$id.u.i-1];
            tg_on_particles(NULL, tx_rect_middle(&o->bbox), -360, 360, 450.0f, 900.0f,
                tx_vec(0, tg_sec.gravity*100), 100, .4f, .4f, .4f, 3, .8f, 49);
        }
        ```
        if push_strength > 0 {
            `tg_explosion_near($id.u.i, (float) a_dbl($push_strength), 0);`
            val cx = `:number tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).x`
            loop i in `:number tg_near_n` {
                val oid = `:number tg_near_id[$i.u.i]`
                val d = `:number tg_near_d[$i.u.i]`
                if oid == PLAYER {
                    `if (!tg_tux.stone) tx_player_add_velocity(&tg_tux, tx_vec(tg_near_ax[$i.u.i], tg_near_ay[$i.u.i]));`
                } else {
                    val t = life.byid@oid
                    if t {
                        match t.pub.kind {
                            :badguy => {
                                ;; a walking badguy, active, gets the speed
                                if t.pub.walks && t.pub.active {
                                    `TG_PHYS($oid.u.i).vx = TG_PHYS($oid.u.i).vx + tg_near_ax[$i.u.i];`
                                    `TG_PHYS($oid.u.i).vy = TG_PHYS($oid.u.i).vy + tg_near_ay[$i.u.i];`
                                }
                            }
                            :block => emit @t :explode [d, cx]
                            else => nil
                        }
                    }
                }
            }
        }
    }

    par :any {
        await :flush
        loop {
            await :update
            match st {
                :waiting => {
                    explode()
                    timer_start(fading, 0.15)
                }
                :exploding => {
                    if timer_check(fading) {
                        timer_start(fading, 1.5)
                        set st = :fading
                    }
                }
                :fading => nil
            }
            until (st == :fading) && timer_check(fading)
        }
    } with {
        ;; the sprite advances when it is drawn, after the step
        loop on :stepped {
            anim_update(a)
        }
    } with {
        ;; `Explosion::collision`: kills what it touches, while it explodes
        loop e on :hit {
            set pub.resp = HIT.ABORT
            if (st == :exploding) && (a.idx <= 8) {
                if e@0 == PLAYER {
                    `if (!tg_tux.stone) tx_player_kill(&tg_tux, 0);`
                } else {
                    val t = life.byid@(e@0)
                    if t && (t.pub.kind == :badguy) {
                        emit @t :kill_fall
                    }
                }
            }
        }
    }
}

;; A badguy of the level: a walking one (`WalkingBadguy`, `SnowBall`,
;; `SmartBall`, `Spiky`, `SSpiky`) or a `Jumpy`.
task BadGuy (life, objs, o, cls, uid) {
    val name = cls.name
    val sprite = o.sprite || cls.sprite
    val w, h = sprite_hitbox(sprite, nil)
    ;; a stalactite is MOVING from the start (`StickyBadguy`)
    val id = obj_new(o.x, o.y, w, h, if cls.kind == :stalactite => COL.MOVING => COL.DISABLED, KIND.BADGUY)
    val l = look_new(sprite, o.x, o.y, if cls.layer => cls.layer => LAYER_OBJECTS)
    `tg_looks[$l.u.i].obj = $id.u.i;`
    `tg_looks[$l.u.i].hidden = 1;`
    set pub = [resp=HIT.FORCE, kind=:badguy, active=false, cls=cls.kind,
               freezable=cls.freezable, can_break=false,
               walks=(cls.kind == :walker) || (cls.kind == :iceblock) || (cls.kind == :bomb)]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
        `tg_look_del($l.u.i);`
    }

    val start_dir = DIRS@(o.direction) || DIR.AUTO
    pin b = [
        state = BG.INIT, dir = if start_dir == DIR.AUTO => DIR.LEFT => start_dir,
        initialized = false, on_ground = false, nx = 0, ny = 0,
        colgroup_active = if cls.kind == :stalactite => COL.TOUCHABLE => COL.MOVING,
        st = :hanging, shake_timer = timer(),               ;; Stalactite
        elapsed = 0, puff_timer = timer(),                  ;; FlyingSnowBall
        bomb = :normal,                                     ;; MrBomb
        glinting = (o.glinting == true),                    ;; m_is_glinting
        ice = :normal, flat_timer = timer(), nokick_timer = timer(),
        squishcount = 0, grabbed = false,                   ;; MrIceBlock
        in_water = false, removed = false,
        state_timer = timer(), turn_timer = timer(), turn_counter = 0,
        alpha = 1, alpha_before = 1,
        walk_speed = cls.walk_speed, max_drop = cls.max_drop,
        start_y = o.y,                                      ;; m_start_position.y
        sleep = if cls.sleeps => :sleeping => :walking,     ;; SSpiky
        ground_y = 0, ground_set = false,                   ;; Jumpy
        anim = anim_new(),
    ]
    if cls.kind == :flying {
        `TG_PHYS($id.u.i).gravity_enabled_flag = 0;`
    }
    val bdir = b.dir
    `tg_bg_new($id.u.i, (uint32_t) $uid.u.i, A_STR_OF($name)->s, (int) $bdir.u.i);`

    ;; the physic, in C
    val func vx ()  { `:number TG_PHYS($id.u.i).vx` }
    val func vy ()  { `:number TG_PHYS($id.u.i).vy` }
    val func ax ()  { `:number TG_PHYS($id.u.i).ax` }
    val func set_vx (v) { `TG_PHYS($id.u.i).vx = (float) a_dbl($v);` }
    val func set_vy (v) { `TG_PHYS($id.u.i).vy = (float) a_dbl($v);` }
    val func set_ax (v) { `TG_PHYS($id.u.i).ax = (float) a_dbl($v);` }
    val func set_ay (v) { `TG_PHYS($id.u.i).ay = (float) a_dbl($v);` }
    val func group (g) { `tg_obj_group($id.u.i, (int) $g.u.i);` }

    ;; `MovingSprite::set_action(name, dir)`: the action, and its hitbox
    val func set_action (act, loops) {
        val aw, ah = sprite_hitbox(sprite, act)
        if aw == nil {
            return nil              ;; no such action: no change
        }
        val lp = loops || -1
        if (b.anim.act == nil) || (b.anim.name != act) {
            anim_set(b.anim, sprite, act, lp)
            set b.anim.name = act
        }
        `tg_look_action_loops($l.u.i, A_STR_OF($act)->s, (int) $lp.u.i);`
        `tg_obj_size($id.u.i, (float) a_dbl($aw), (float) a_dbl($ah));`
    }
    val func set_dir (d) {
        set b.dir = d
        `tg_bg_dir[$id.u.i] = (int) $d.u.i;`
    }

    if cls.kind == :jumpy {
        set_action(DIR_NAME@(b.dir) ++ "-middle")     ;; `Jumpy::Jumpy`
    }

    ;; `BadGuy::set_state`
    val func set_state (s) {
        if b.state != s {
            val last = b.state
            `tg_bg_state_trace($id.u.i, (int) $last.u.i, (int) $s.u.i);`
            set b.state = s
            match s {
                BG.SQUISHED => timer_start(b.state_timer, 2)
                BG.FADING   => timer_start(b.state_timer, 0.2 * b.alpha)
                BG.ACTIVE   => {
                    group(b.colgroup_active)
                    `tg_looks[$l.u.i].hidden = 0;`
                }
                BG.INACTIVE => {
                    if (last == BG.SQUISHED) || (last == BG.FALLING) {
                        set b.removed = true
                    }
                    group(COL.DISABLED)
                    `tg_looks[$l.u.i].hidden = 1;`
                }
                BG.FALLING => {
                    group(COL.DISABLED)
                    `tg_looks[$l.u.i].vflip = 1;`
                }
                else => nil
            }
        }
    }

    ;; `BadGuy::run_dead_script` (no dead scripts yet)
    val func run_dead_script () {
        if pub.active {
            set pub.active = false
            ;; a glinting badguy leaves a coin
            if b.glinting {
                val cx = `:number tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).x - 16.0f`
                val cy = `:number tg_objs[$id.u.i-1]->bbox.y1 - 32.0f`
                val vx = `:number tr_randf(&tg_grand, -96.0f, 96.0f)`
                spawn @objs HeavyCoin(life, objs, cx, cy, vx)
            }
            set b.glinting = false
        }
    }

    ;; `BadGuy::kill_fall`
    val func kill_fall () {
        if cls.kind == :bomb {
            ;; `MrBomb::kill_fall`: it explodes
            if b.grabbed {
                `tx_player_stop_grabbing(&tg_tux);`
            }
            if !b.removed {
                set b.removed = true
                `tg_obj_del($id.u.i);`
                `tg_look_del($l.u.i);`
                val cx = `:number tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).x`
                val cy = `:number tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).y`
                spawn @objs Explosion(life, cx, cy, 1464.8 * 32.0 * 32.0)
                run_dead_script()
            }
            return nil
        }
        if pub.active && (cls.kind != :stalactite) {
            set_vy(0)
            set_ay(0)
            `TG_PHYS($id.u.i).gravity_enabled_flag = 1;`
            set_state(BG.FALLING)
            `tg_looks[$l.u.i].layer = tg_foremost + 1;`
            run_dead_script()
        }
    }

    ;; `BadGuy::kill_squished`, by the player
    val func kill_squished () {
        if pub.active {
            `TG_PHYS($id.u.i).gravity_enabled_flag = 1;`
            set_vx(0)
            set_vy(0)
            set_state(BG.SQUISHED)
            group(COL.MOVING_ONLY_STATIC)
            `tx_player_bounce(&tg_tux);`
            run_dead_script()
        }
    }

    ;; `WalkingBadguy::turn_around`
    val func turn_around () {
        set_dir(if b.dir == DIR.LEFT => DIR.RIGHT => DIR.LEFT)
        if (cls.kind == :bouncing) || (b.state == BG.INIT) || (b.state == BG.INACTIVE) || (b.state == BG.ACTIVE) {
            set_action(DIR_NAME@(b.dir))
        }
        `TG_PHYS($id.u.i).vx = -TG_PHYS($id.u.i).vx;`
        `TG_PHYS($id.u.i).ax = -TG_PHYS($id.u.i).ax;`
        ;; if we get dizzy, we fall off the screen
        if timer_started(b.turn_timer) {
            val c = b.turn_counter
            set b.turn_counter += 1
            if c > 10 {
                kill_fall()
            }
        } else {
            timer_start(b.turn_timer, 1)
            set b.turn_counter = 0
        }
    }

    ;; `WalkingBadguy::initialize`
    val func walk_initialize () {
        set_action(DIR_NAME@(b.dir))
        set_vx(if b.dir == DIR.LEFT => -b.walk_speed => b.walk_speed)
        set_ax(0)
    }

    ;; `initialize`: `SSpiky::initialize`, for one that sleeps
    val func initialize () {
        if cls.kind == :bouncing {
            set_vx(if b.dir == DIR.LEFT => -80 => 80)
            set_action(DIR_NAME@(b.dir))
            return nil
        }
        if cls.kind == :flying {
            set_action(DIR_NAME@(b.dir))
            return nil
        }
        if (cls.kind != :walker) && (cls.kind != :iceblock) && (cls.kind != :bomb) {
            return nil              ;; `BadGuy::initialize`
        }
        if cls.sleeps {
            set b.sleep = :sleeping
            set_vx(0)
            set_action("sleeping-" ++ DIR_NAME@(b.dir))
        } else {
            walk_initialize()
        }
    }

    ;; `BadGuy::try_activate`
    val func try_activate () {
        if `:boolean tg_player_alive()` && !`:boolean tg_bg_offscreen($id.u.i)` {
            set_state(BG.ACTIVE)
            if !b.initialized {
                if start_dir == DIR.AUTO {
                    set_dir(if `:boolean tx_rect_left(&tg_tux.col.bbox) > tx_rect_right(&tg_objs[$id.u.i-1]->bbox)` => DIR.RIGHT => DIR.LEFT)
                }
                initialize()
                set b.initialized = true
            }
            ;; `FlyingSnowBall::activate`
            if cls.kind == :flying {
                timer_start(b.puff_timer, `:number tr_randf(&tg_rand, 4.0f, 8.0f)`)
            }
        }
    }

    ;; `BadGuy::active_update`
    val func base_active_update () {
        val water = b.in_water
        `tg_bg_move($id.u.i, a_truthy($water));`
    }

    ;; `WalkingBadguy::active_update`
    val func walk_active_update () {
        base_active_update()
        ;; walk down slopes smoothly
        if b.on_ground && (b.ny != 0) && ((b.nx * vx()) >= 0) {
            set_vy((math.abs(vx()) * math.abs(b.nx)) + 100)
        }
        val cur = vx()
        val dest = if b.dir == DIR.LEFT => -b.walk_speed => b.walk_speed
        ifs {
            (cur > (dest - 5.0)) && (cur < (dest + 5.0)) => {
                set_vx(dest)
                set_ax(0)
            }
            ((dest <= 0) && (cur > dest)) || ((dest > 0) && (cur < dest)) => {
                set_ax(dest * 1.0)
            }
            else => {
                set_ax(-1.0 * dest)
            }
        }
        val drop = b.max_drop
        if (drop > -1) && b.on_ground && `:boolean tg_bg_might_fall($id.u.i, (int) a_dbl($drop) + 1)` {
            turn_around()
        }
        ifs {
            (b.dir == DIR.LEFT) && (vx() > 0) => {
                set_dir(DIR.RIGHT)
                set_action("right")
            }
            (b.dir == DIR.RIGHT) && (vx() < 0) => {
                set_dir(DIR.LEFT)
                set_action("left")
            }
            else => nil
        }
    }

    ;; `Stalactite::active_update`
    val func stalactite_active_update () {
        match b.st {
            :hanging => {
                if `:boolean tg_player_alive()` && `:boolean tg_stalactite_reach($id.u.i)` {
                    timer_start(b.shake_timer, 0.8)
                    set b.st = :shaking
                }
            }
            :shaking => {
                val dx = `:number tr_rand(&tg_grand, -3, 3)`
                `tg_looks[$l.u.i].dx = (float) a_dbl($dx);`
                if timer_check(b.shake_timer) {
                    set b.st = :falling
                    `TG_PHYS($id.u.i).gravity_enabled_flag = 1;`
                    set b.colgroup_active = COL.MOVING          ;; `set_colgroup_active`
                    if b.state == BG.ACTIVE {
                        group(COL.MOVING)
                    }
                    `tg_looks[$l.u.i].dx = 0;`
                }
            }
            :falling => `tg_obj_physic_move($id.u.i);`
            else => nil
        }
    }

    ;; `Stalactite::squish`
    val func squish () {
        set b.st = :squished
        `TG_PHYS($id.u.i).gravity_enabled_flag = 1;`
        set_vx(0)
        set_vy(0)
        set_state(BG.SQUISHED)
        set_action("squished")
        `tg_looks[$l.u.i].layer = 50;`      ;; drawn in LAYER_OBJECTS
        group(COL.MOVING_ONLY_STATIC)
        run_dead_script()
    }

    ;; `update_on_ground_flag`
    val func on_ground_hit (bits, nx, ny) {
        if (bits & HIT.BOTTOM) != 0 {
            set b.on_ground = true
            set b.nx, b.ny = nx, ny
        }
    }

    ;; `Jumpy::hit`
    val func jumpy_hit (bits, nx, ny) {
        if (bits & HIT.BOTTOM) != 0 {
            set b.ground_y = `:number tg_objs[$id.u.i-1]->bbox.y1`
            set b.ground_set = true
            set_vy(if b.state != BG.ACTIVE => 0 => -600)
            on_ground_hit(bits, nx, ny)
        } else {
            if (bits & HIT.TOP) != 0 {
                set_vy(0)
            }
        }
        HIT.CONTINUE
    }

    ;; `Jumpy::active_update`
    val func jumpy_active_update () {
        base_active_update()
        if `:boolean tg_player_alive()` {
            set_dir(if `:boolean tg_tux.col.bbox.x1 > tg_objs[$id.u.i-1]->bbox.x1` => DIR.RIGHT => DIR.LEFT)
        }
        val d = DIR_NAME@(b.dir)
        if !b.ground_set {
            set_action("editor-" ++ d)
            return nil
        }
        val y = `:number tg_objs[$id.u.i-1]->bbox.y1`
        ifs {
            y > b.ground_y => set_action(d ++ "-down")
            y < (b.ground_y - 4) => set_action(d ++ "-up")
            (y >= (b.ground_y - 4)) && (y < (b.ground_y - 2)) => set_action(d ++ "-middle")
            else => set_action(d ++ "-down")
        }
    }

    ;; `BouncingSnowball::active_update`
    val func bouncing_active_update () {
        base_active_update()
        val d = DIR_NAME@(b.dir)
        val act = b.anim.name
        if ((act == "left-up") || (act == "right-up")) && anim_done(b.anim) {
            set_action(d)
        }
        val ground = `:boolean !tg_bsnow_free_below($id.u.i)`
        if ground && (vy() >= 64.0) {
            set_action(d ++ "-down")
        }
        if !ground && ((b.anim.name == "left-down") || (b.anim.name == "right-down")) {
            set_action(d)
        }
        ;; left-right faux collision
        val bd = b.dir
        if !`:boolean tg_bsnow_free_side($id.u.i, (int) $bd.u.i)` {
            set_dir(if b.dir == DIR.LEFT => DIR.RIGHT => DIR.LEFT)
            set_action(DIR_NAME@(b.dir))
            `TG_PHYS($id.u.i).vx = -TG_PHYS($id.u.i).vx;`
        }
    }

    ;; `FlyingSnowBall::active_update`
    val func flying_active_update () {
        ;; the height it flies to: sin(x)^3 + sin(3(x - pi/3))/3, around the
        ;; start, at 0.8 the speed; its velocity reaches it in one second
        val mult = 0.8
        set b.elapsed = (b.elapsed + step_dt()) % (6.28318530717958647692 / mult)
        val delta = b.elapsed * mult
        val h = math.pow(math.sin(delta), 3.0) +
                (math.sin(3.0 * ((delta - 3.14159265358979323846) / 3.0)) / 3.0)
        val target = (h * 100.0) + b.start_y
        set_vy(target - `:number tg_objs[$id.u.i-1]->bbox.y1`)
        `tx_obj_set_movement(tg_objs[$id.u.i-1], tx_physic_get_movement(&TG_PHYS($id.u.i), tg_sec.gravity, 1.f));`
        if `:boolean tg_player_alive()` {
            set_dir(if `:boolean tg_tux.col.bbox.x1 > tg_objs[$id.u.i-1]->bbox.x1` => DIR.RIGHT => DIR.LEFT)
            set_action(DIR_NAME@(b.dir))
        }
        ;; puffs of smoke
        if timer_check(b.puff_timer) {
            val px = `:number tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).x`
            val py = `:number tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).y`
            val sx = `:number tr_randf(&tg_grand, -10, 10)`
            spawn @objs SpriteParticle("images/particles/smoke.sprite", "default", px, py, sx, 150, 0, 0, LAYER_OBJECTS - 1)
            timer_start(b.puff_timer, `:number tr_randf(&tg_rand, 4.0f, 8.0f)`)
        }
    }

    ;; whether the player can grab it now (`is_portable`, not grabbed)
    val func ice_portable () {
        val p = (b.ice == :flat) && !b.grabbed
        `tg_bg_portable[$id.u.i] = a_truthy($p);`
        set pub.can_break = (b.ice == :kicked) || (b.ice == :flat)     ;; `can_break`
    }

    ;; `MrIceBlock::set_state`
    val func ice_state (st) {
        if b.ice != st {
            val d = DIR_NAME@(b.dir)
            match st {
                :normal => {
                    set_action(d, -1)
                    walk_initialize()
                }
                :flat => {
                    set_action("flat-" ++ d, -1)
                    timer_start(b.flat_timer, 4)
                }
                :kicked => {
                    set_vx(if b.dir == DIR.LEFT => -500 => 500)
                    set_action("flat-" ++ d, -1)
                    ;; we should slide above 1 block holes now: the size of
                    ;; the box only (`m_bbox.set_size`), not of its
                    ;; destination, which the collisions keep
                    `tx_rect_set_size(&tg_objs[$id.u.i-1]->bbox, 34, 31.8f);`
                }
                :grabbed => set b.flat_timer.period = 0
                :waking => {
                    set b.flat_timer.period = 0
                    set_action("waking-" ++ d, 1)
                }
            }
            set b.ice = st
            ice_portable()
        }
    }

    ;; `MrIceBlock::active_update`
    val func ice_active_update () {
        if (b.ice == :grabbed) || b.grabbed {
            return nil
        }
        if (b.ice == :flat) && timer_check(b.flat_timer) {
            ice_state(:waking)
        }
        if (b.ice == :waking) && anim_done(b.anim) {
            ice_state(:normal)
        }
        if b.ice == :normal {
            walk_active_update()
            return nil
        }
        base_active_update()
    }

    ;; `MrIceBlock::collision_squished`, by the player
    val func ice_squished () {
        if `:boolean tg_tux.does_buttjump || tx_player_is_invincible(&tg_tux)` {
            `tx_player_bounce(&tg_tux);`
            kill_fall()
            return true
        }
        ifs {
            (b.ice == :kicked) || (b.ice == :normal) => {
                set b.squishcount += 1
                if b.squishcount >= 10 {
                    kill_fall()
                    return true
                }
                set_vx(0)
                set_vy(0)
                ice_state(:flat)
                timer_start(b.nokick_timer, 0.1)
            }
            (b.ice == :flat) || (b.ice == :waking) => {
                set_dir(if `:boolean tg_tux.col.bbox.x1 < tg_objs[$id.u.i-1]->bbox.x1` => DIR.RIGHT => DIR.LEFT)
                if timer_check(b.nokick_timer) {
                    ice_state(:kicked)
                }
            }
            else => nil
        }
        `tx_player_bounce(&tg_tux);`
        true
    }

    ;; `MrIceBlock::grab`: held by the player at `x`, `y`
    val func ice_grab (x, y, d) {
        set b.grabbed = true
        ```
        {
            TxObj* o = tg_objs[$id.u.i-1];
            TxVec mv = tx_vec_sub(tx_vec((float) a_dbl($x), (float) a_dbl($y)), tx_obj_get_pos(o));
            tx_obj_set_movement(o, mv);
            const float LOGICAL_FPS = 1000.0f / 15.0f;
            TG_PHYS($id.u.i).vx = mv.x * LOGICAL_FPS;
            TG_PHYS($id.u.i).vy = mv.y * LOGICAL_FPS;
        }
        ```
        set_dir(d)
        set_action("flat-" ++ DIR_NAME@(b.dir), -1)
        ice_state(:grabbed)
        set b.colgroup_active = COL.DISABLED
        if b.state == BG.ACTIVE {
            group(COL.DISABLED)
        }
        ice_portable()
    }

    ;; `MrIceBlock::ungrab`: thrown, put down, or kicked
    val func ice_ungrab (d) {
        ifs {
            d == DIR.UP => {
                set_vy(-500)
                if `:boolean fabsf(tg_tux.physic.vx) < 1.0f` {
                    ice_state(:flat)
                } else {
                    set_dir(if vx() > 0 => DIR.RIGHT => DIR.LEFT)
                    ice_state(:kicked)
                }
            }
            d == DIR.DOWN => {
                if `:boolean tg_ice_free_below($id.u.i)` {
                    set_vy(500)
                }
                ice_state(:flat)
            }
            else => {
                set_dir(d)
                ice_state(:kicked)
            }
        }
        set b.colgroup_active = COL.MOVING
        if b.state == BG.ACTIVE {
            group(COL.MOVING)
        }
        set b.grabbed = false
        ice_portable()
    }

    ;; `MrBomb::trigger`: it ticks
    val func bomb_trigger () {
        set b.bomb = :ticking
        set_action("ticking-" ++ DIR_NAME@(b.dir), 1)
        set_vx(0)
        `tx_player_bounce(&tg_tux);`
        `tg_bg_portable[$id.u.i] = 1;`      ;; `is_portable`, while ticking
    }

    ;; `MrBomb::update_ticking`
    val func bomb_ticking () {
        if b.on_ground {
            set_vx(0)
        }
        if anim_done(b.anim) {
            kill_fall()
        } else {
            if !b.grabbed {
                `tg_obj_physic_move($id.u.i);`
            }
        }
    }

    ;; `MrBomb::grab`
    val func bomb_grab (x, y, d) {
        set b.grabbed = true
        `tg_bg_portable[$id.u.i] = 0;`
        if b.bomb == :ticking {
            ;; it faces the other way than Tux, its loops continued
            val act = "ticking-" ++ DIR_NAME@(b.dir)
            set b.anim.name = act
            `tg_look_action_loops($l.u.i, A_STR_OF($act)->s, -100);`
            set b.colgroup_active = COL.DISABLED
            if b.state == BG.ACTIVE {
                group(COL.DISABLED)
            }
        }
        ```
        {
            TxObj* o = tg_objs[$id.u.i-1];
            TxVec mv = tx_vec_sub(tx_vec((float) a_dbl($x), (float) a_dbl($y)), tx_obj_get_pos(o));
            tx_obj_set_movement(o, mv);
            const float LOGICAL_FPS = 1000.0f / 15.0f;
            TG_PHYS($id.u.i).vx = mv.x * LOGICAL_FPS;
            TG_PHYS($id.u.i).vy = mv.y * LOGICAL_FPS;
        }
        ```
        set_dir(d)
        set b.colgroup_active = COL.DISABLED
        if b.state == BG.ACTIVE {
            group(COL.DISABLED)
        }
    }

    ;; `MrBomb::ungrab`
    val func bomb_ungrab (d) {
        val du, dd = DIR.UP, DIR.DOWN
        ```
        {
            float pvx = tg_tux.physic.vx;
            int pdir = tg_tux.dir;
            TxPhysic* ph = &TG_PHYS($id.u.i);
            if (fabsf(pvx) < 1.0f)
                ph->vx = 0.f;
            else if ((pdir == TX_DIR_LEFT && pvx <= -1.0f) || (pdir == TX_DIR_RIGHT && pvx >= 1.0f))
                ph->vx = pvx + (pdir == TX_DIR_LEFT ? -10.f : 10.f);
            else
                ph->vx = pvx + (pdir == TX_DIR_LEFT ? -330.f : 330.f);
            int dir_ = (int) $d.u.i;
            ph->vy = dir_ == (int) $du.u.i ? -500.f : dir_ == (int) $dd.u.i ? 500.f :
                     pvx != 0.f ? -200.f : 0.f;
        }
        ```
        set b.colgroup_active = COL.MOVING
        if b.state == BG.ACTIVE {
            group(COL.MOVING)
        }
        set b.grabbed = false
        `tg_bg_portable[$id.u.i] = 1;`
    }

    ;; `active_update`: `SSpiky::active_update`, for one that sleeps
    val func active_update () {
        if cls.kind == :bomb {
            if b.bomb == :ticking {
                bomb_ticking()
            } else {
                walk_active_update()
            }
            return nil
        }
        if cls.kind == :iceblock {
            ice_active_update()
            return nil
        }
        if cls.kind == :bouncing {
            bouncing_active_update()
            return nil
        }
        if cls.kind == :flying {
            flying_active_update()
            return nil
        }
        if cls.kind == :stalactite {
            stalactite_active_update()
            return nil
        }
        if cls.kind == :jumpy {
            jumpy_active_update()
            return nil
        }
        if b.sleep == :walking {
            walk_active_update()
            return nil
        }
        if b.sleep == :sleeping {
            ;; wakes up when the player comes in reach
            if `:boolean tg_player_alive()` {
                val d = b.dir
                if `:boolean tg_sspiky_reach($id.u.i, (int) $d.u.i)` {
                    set_action("waking-" ++ DIR_NAME@(b.dir), 1)
                    set b.sleep = :waking
                }
            }
            base_active_update()
        }
        if b.sleep == :waking {
            if anim_done(b.anim) {
                set b.sleep = :walking
                walk_initialize()
            }
            base_active_update()
        }
    }

    ;; `BadGuy::update`
    val func update () {
        if `:boolean tg_bg_out($id.u.i)` && !b.grabbed {
            run_dead_script()
            set b.removed = true
            return nil
        }
        ;; deactivate, if off screen and not falling down
        if pub.active && `:boolean tg_bg_offscreen($id.u.i)` && (vy() <= 0) {
            ;; `Stalactite::deactivate`: one that is not hanging is gone
            if (cls.kind == :stalactite) && (b.st != :hanging) {
                set b.removed = true
            }
            set_state(BG.INACTIVE)
        }
        val water = b.in_water
        set b.in_water = `:boolean tg_bg_water($id.u.i, a_truthy($water))`
        match b.state {
            BG.ACTIVE => {
                set pub.active = true
                ;; a glinting badguy sparkles
                if b.glinting && (`:number tr_rand(&tg_grand, 0, 8)` == 0) {
                    val px = `:number tr_randf(&tg_grand, tg_objs[$id.u.i-1]->bbox.x1, tx_rect_right(&tg_objs[$id.u.i-1]->bbox))`
                    val py = `:number tr_randf(&tg_grand, tg_objs[$id.u.i-1]->bbox.y1, tx_rect_bottom(&tg_objs[$id.u.i-1]->bbox))`
                    spawn @objs SpriteParticle("images/particles/glint.sprite", "default", px, py, 0, 0, 0, 0, LAYER_OBJECTS + 6)
                }
                active_update()
            }
            BG.INIT => {
                set pub.active = false
                set b.in_water = `:boolean tg_bg_in_water($id.u.i)`
                try_activate()
            }
            BG.INACTIVE => {
                set pub.active = false
                set b.in_water = `:boolean tg_bg_in_water($id.u.i)`
                try_activate()
            }
            BG.SQUISHED => {
                set pub.active = false
                if timer_check(b.state_timer) {
                    if b.alpha > 0 {
                        set b.alpha_before = b.alpha
                        set_state(BG.FADING)
                    } else {
                        set b.removed = true
                    }
                } else {
                    `tg_obj_physic_move($id.u.i);`
                }
            }
            BG.FADING => {
                if timer_check(b.state_timer) {
                    set b.removed = true
                } else {
                    set b.alpha = b.alpha_before * (1.0 - timer_progress(b.state_timer))
                    val a = b.alpha
                    `tg_looks[$l.u.i].alpha = (float) a_dbl($a);`
                }
            }
            BG.FALLING => {
                set pub.active = false
                `tg_obj_physic_move($id.u.i);`
            }
        }
        set b.on_ground = false
    }

    ;; `WalkingBadguy::collision_solid` (`BadGuy::collision_solid` for one
    ;; that is not walking)
    val func collision_solid (bits, nx, ny) {
        if (cls.kind == :bomb) && (b.bomb == :ticking) {
            ;; `MrBomb::collision_solid`, while it ticks
            if (bits & HIT.BOTTOM) != 0 {
                set_vx(0)
                set_vy(0)
            } else {
                kill_fall()
            }
            on_ground_hit(bits, nx, ny)
            return nil
        }
        if cls.kind == :iceblock {
            ;; `MrIceBlock::collision_solid`
            on_ground_hit(bits, nx, ny)
            if (bits & (HIT.TOP | HIT.BOTTOM)) != 0 {
                set_vy(0)
            }
            match b.ice {
                :normal => nil      ;; as a walking badguy, below
                :kicked => {
                    if (bits & (HIT.LEFT | HIT.RIGHT)) != 0 {
                        if (((bits & HIT.RIGHT) != 0) && (b.dir == DIR.RIGHT)) ||
                           (((bits & HIT.LEFT) != 0) && (b.dir == DIR.LEFT))
                        {
                            set_dir(if b.dir == DIR.LEFT => DIR.RIGHT => DIR.LEFT)
                        }
                        set_vx(-vx() * 0.975)
                    }
                    set_action("flat-" ++ DIR_NAME@(b.dir), -1)
                    if math.abs(vx()) < (b.walk_speed * 1.5) {
                        ice_state(:normal)
                    }
                    return nil
                }
                :grabbed => return nil
                else => {
                    set_vx(0)       ;; flat, waking
                    return nil
                }
            }
        }
        if cls.kind == :flying {
            if (bits & (HIT.TOP | HIT.BOTTOM)) != 0 {
                set_vy(0)
            }
            return nil
        }
        if cls.kind == :bouncing {
            ;; `BouncingSnowball::collision_solid`
            if !pub.active {
                set_vx(0)
                set_vy(0)
                on_ground_hit(bits, nx, ny)
                return nil
            }
            ifs {
                (bits & HIT.BOTTOM) != 0 => {
                    if b.state == BG.ACTIVE {
                        val bounce = -vy() * 0.8
                        set_vy(math.min(-450, bounce))
                        set_action(DIR_NAME@(b.dir) ++ "-up", 1)
                    } else {
                        set_vy(0)
                    }
                }
                (bits & HIT.TOP) != 0 => set_vy(0)
                else => nil
            }
            return nil
        }
        if cls.kind == :stalactite {
            if (b.st == :falling) && ((bits & HIT.BOTTOM) != 0) {
                squish()
            }
            return nil
        }
        if cls.kind == :jumpy {
            jumpy_hit(bits, nx, ny)
            return nil
        }
        if b.sleep != :walking {
            set_vx(0)
            set_vy(0)
            on_ground_hit(bits, nx, ny)
            return nil
        }
        on_ground_hit(bits, nx, ny)
        if !pub.active {
            ;; `BadGuy::collision_solid`
            set_vx(0)
            set_vy(0)
            on_ground_hit(bits, nx, ny)
        } else {
            if ((bits & HIT.TOP) != 0) && (vy() < 0) {
                set_vy(0)
            }
            if ((bits & HIT.BOTTOM) != 0) && (vy() > 0) {
                set_vy(0)
            }
            if ((bits & HIT.FLAT) != 0) &&
               ((((bits & HIT.LEFT) != 0) && (b.dir == DIR.LEFT)) ||
                (((bits & HIT.RIGHT) != 0) && (b.dir == DIR.RIGHT)))
            {
                turn_around()
            }
        }
    }

    ;; `BadGuy::collision_tile`
    val func collision_tile (attrs) {
        if pub.active {
            if ((attrs & TILE.WATER) != 0) && ((attrs & TILE.HURTS) == 0) && !b.in_water {
                set b.in_water = true
            }
            if ((attrs & TILE.HURTS) != 0) {
                if `:boolean tg_bg_hurt($id.u.i)` || ((attrs & TILE.UNISOLID) != 0) {
                    if (attrs & TILE.FIRE) == 0 {
                        kill_fall()
                    }
                }
            }
        }
    }

    ;; `BadGuy::collision`, `WalkingBadguy::collision_badguy`,
    ;; `BadGuy::collision_player`, `SnowBall::collision_squished`
    val func collision (other, bits) {
        if (cls.kind == :bomb) && (b.bomb == :ticking) {
            ;; `MrBomb::collision`, while it ticks: a player or a badguy
            ;; that it hits while it moves makes it explode
            val t = life.byid@other
            if (other == PLAYER) || (t && (t.pub.kind == :badguy)) {
                if (vx() != 0) || (vy() != 0) {
                    kill_fall()
                }
                return HIT.ABORT
            }
        }
        if (cls.kind == :bomb) && b.grabbed {
            return HIT.FORCE
        }
        if (cls.kind == :iceblock) && (b.ice == :grabbed) {
            return HIT.FORCE
        }
        if !pub.active {
            return HIT.ABORT
        }
        if b.grabbed {
            return HIT.FORCE
        }
        val t = life.byid@other
        if t && (t.pub.kind == :badguy) {
            if t.pub.active && `:boolean tg_objs[$other.u.i-1]->group == TX_COLGROUP_MOVING` {
                if (cls.kind == :bomb) && (b.bomb != :normal) {
                    return HIT.FORCE
                }
                if cls.kind == :iceblock {
                    ;; `MrIceBlock::collision_badguy`
                    match b.ice {
                        :flat   => return HIT.FORCE
                        :waking => return HIT.FORCE
                        :kicked => {
                            emit @t :kill_fall
                            return HIT.FORCE
                        }
                        else => nil     ;; as a walking badguy, below
                    }
                }
                if cls.kind == :stalactite {
                    ;; `Stalactite::collision_badguy`
                    ifs {
                        b.st == :squished => return HIT.ABORT
                        t.pub.cls == :stalactite => return HIT.FORCE
                        b.st != :falling => return HIT.FORCE
                        else => {
                            if t.pub.freezable {
                                `fprintf(stderr, "stalactite: freeze not done\n");`
                            } else {
                                emit @t :kill_fall
                            }
                            return HIT.FORCE
                        }
                    }
                }
                if cls.kind == :jumpy {
                    return jumpy_hit(bits, 0, 0)
                }
                if cls.kind == :flying {
                    return HIT.FORCE        ;; `BadGuy::collision_badguy`
                }
                if cls.kind == :bouncing {
                    ;; `BouncingSnowball::collision_badguy`
                    if (((bits & HIT.LEFT) != 0) && (b.dir == DIR.LEFT)) ||
                       (((bits & HIT.RIGHT) != 0) && (b.dir == DIR.RIGHT))
                    {
                        turn_around()
                    } else {
                        collision_solid(bits, 0, 0)
                    }
                    return HIT.CONTINUE
                }
                if b.sleep != :walking {
                    return HIT.FORCE        ;; `BadGuy::collision_badguy`
                }
                if (bits & HIT.TOP) != 0 {
                    return HIT.FORCE
                }
                if (((bits & HIT.LEFT) != 0) && (b.dir == DIR.LEFT)) ||
                   (((bits & HIT.RIGHT) != 0) && (b.dir == DIR.RIGHT))
                {
                    turn_around()
                }
                return HIT.CONTINUE
            }
        }
        if other == PLAYER {
            ;; hit from above?
            if `:boolean tx_rect_bottom(&tg_tux.col.bbox) < (tx_rect_top(&tg_objs[$id.u.i-1]->bbox) + 16)` {
                if `:boolean tg_tux.stone` {
                    kill_fall()
                    return HIT.FORCE
                }
                if cls.kind == :iceblock {
                    ice_squished()
                    return HIT.FORCE
                }
                if cls.kind == :bomb {
                    ;; `MrBomb::collision_squished`
                    if `:boolean tx_player_is_invincible(&tg_tux)` {
                        `tx_player_bounce(&tg_tux);`
                        kill_fall()
                        return HIT.FORCE
                    }
                    if b.bomb != :ticking {
                        bomb_trigger()
                    }
                    return HIT.FORCE
                }
                if cls.squish {
                    set_action("squished-" ++ DIR_NAME@(b.dir))
                    if cls.kind == :flying {
                        `TG_PHYS($id.u.i).gravity_enabled_flag = 1;`
                        set_ay(0)
                        set_vy(0)
                    }
                    kill_squished()
                    return HIT.FORCE
                }
            }
            if (cls.kind == :iceblock) && ((b.ice == :waking) || (b.ice == :flat)) && (b.state == BG.ACTIVE) {
                ;; `MrIceBlock::collision_player`: kicked from a side
                if (bits & HIT.LEFT) != 0 {
                    set_dir(DIR.RIGHT)
                    `tx_player_kick(&tg_tux);`
                    ice_state(:kicked)
                    return HIT.FORCE
                }
                if (bits & HIT.RIGHT) != 0 {
                    set_dir(DIR.LEFT)
                    `tx_player_kick(&tg_tux);`
                    ice_state(:kicked)
                    return HIT.FORCE
                }
            }
            if cls.kind == :stalactite {
                ;; `Stalactite::collision_player`
                if b.st != :squished {
                    `tx_player_kill(&tg_tux, 0);`
                }
                return HIT.FORCE
            }
            ;; `BadGuy::collision_player`
            if `:boolean tx_player_is_invincible(&tg_tux)` {
                kill_fall()
                return HIT.ABORT
            }
            ;; the player carries a badguy: both die (the carried one is let
            ;; go twice, as the original: by itself, and by `stop_grabbing`)
            val g = `:number tg_tux.grabbed_object ? tg_tux.grabbed_object->id : -1`
            val tg = life.byid@g
            if (g > 0) && tg && (tg.pub.kind == :badguy) {
                val pd = `:number tg_tux.dir`
                emit @tg :ungrab [pd]
                `tx_player_stop_grabbing(&tg_tux);`
                emit @tg :kill_fall
                kill_fall()
                return HIT.ABORT
            }
            `tx_player_kill(&tg_tux, 0);`
            return HIT.FORCE
        }
        HIT.FORCE
    }

    par :any {
        loop {
            await :update
            until b.removed         ;; gone in a collision (a bomb exploded)
            update()
            until b.removed
        }
    } with {
        ;; the sprite advances when it is drawn, after the step
        loop on :stepped {
            if (b.state != BG.INIT) && (b.state != BG.INACTIVE) {
                anim_update(b.anim)
            }
        }
    } with {
        loop e on :solid {
            collision_solid(e@0, e@1, e@2)
        }
    } with {
        loop e on :tile {
            collision_tile(e@0)
        }
    } with {
        loop e on :hit {
            set pub.resp = collision(e@0, e@1)
        }
    } with {
        loop on :kill_fall {
            kill_fall()
        }
    } with {
        loop e on :grab {
            if cls.kind == :bomb {
                bomb_grab(e@0, e@1, e@2)
            } else {
                ice_grab(e@0, e@1, e@2)
            }
        }
    } with {
        loop e on :ungrab {
            if cls.kind == :bomb {
                bomb_ungrab(e@0)
            } else {
                ice_ungrab(e@0)
            }
        }
    }
}
