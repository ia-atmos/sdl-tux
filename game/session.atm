;; The session of a level: its lives, one after the other.
;;
;; The program that includes this file emits, per logical step of 15 ms:
;;
;;      :step [[control, value], ...]       the keys that change in the step
;;
;; (controls as in the original: 0 left, 1 right, 2 up, 3 down, 4 jump,
;; 5 action, 6 item), and the session emits back, after each step:
;;
;;      :stepped

```:prelude
#include "game/tux.h"
```

include "data.atm"
include "script.atm"

;; The controls, in the order of the original (`Control`).
pin CONTROLS = [left=0, right=1, up=2, down=3, jump=4, action=5, item=6,
                start=7, escape=8]

;; The collision groups and the responses to a collision, as in the
;; original.
pin COL = [DISABLED=0, MOVING_STATIC=1, MOVING=2, MOVING_ONLY_STATIC=3, STATIC=4, TOUCHABLE=5]
pin HIT = [ABORT=0, CONTINUE=1, FORCE=2, LEFT=1, RIGHT=2, TOP=4, BOTTOM=8, CRUSH=16,
           FLAT=32, SIDES=15]   ;; FLAT: the normal of the slope has no x

val PLAYER = 0      ;; the id of the player in a collision

;; The kinds of the objects, for the collisions of the player (TX_OTHER_*),
;; and the events that the player gives to a trigger (TX_EVENT_*).
pin KIND = [OTHER=`:number TX_OTHER_OTHER`, TRIGGER=`:number TX_OTHER_TRIGGER`,
            BADGUY=`:number TX_OTHER_BADGUY`]
pin EVENT = [TOUCH=`:number TX_EVENT_TOUCH`, ACTIVATE=`:number TX_EVENT_ACTIVATE`]

;; The sequences, as in the original (`Sequence`).
pin SEQ = [END=0, STOPTUX=1, FIREWORKS=2]
pin SEQS = [endsequence=SEQ.END, stoptux=SEQ.STOPTUX, fireworks=SEQ.FIREWORKS]

;; The offset of a tilemap that has a path, with the path stopped at its
;; starting node (`TileMap::finish_construction`): the position of the
;; node, less the handle. A path that moves is not done yet.
func map_offset (sec, o) {
    var path = o.path
    if o.path_ref {
        loop _,p in sec {
            if (type(p) == :table) && (p.tag == :path) && (p.name == o.path_ref) {
                set path = p.path
            }
        }
    }
    var node
    var k = 0
    val start = o.starting_node || 0
    if path {
        loop _,n in path {
            if (type(n) == :table) && (n.tag == :node) {
                if (k <= start) || (node == nil) {
                    set node = n
                }
                set k += 1
            }
        }
    }
    if node == nil {
        return (0, 0)
    }
    val h = o.handle || []
    val w32, h32 = o.width * 32, o.height * 32
    (node.x - w32 * (h.scale_x || 0) - (h.offset_x || 0),
     node.y - h32 * (h.scale_y || 0) - (h.offset_y || 0))
}

;; A new object of the collisions: its id.
func obj_new (x, y, w, h, group, kind) {
    `:number tg_obj_new((float)a_dbl($x), (float)a_dbl($y), (float)a_dbl($w), (float)a_dbl($h), (int)$group.u.i, (int)$kind.u.i)`
}

;; What the session keeps across the lives of a level.
pin status = [coins=100, state=[]]

;; The objects of a sector are tasks in a pool, in the order of the
;; level. Each one owns an object of the collisions, with an id, and
;; receives its collisions as the event
;;
;;      :hit [other, bits]      the id of the other, the sides as HIT.*
;;
;; The response to a collision is the field `resp` of its `pub`, which
;; the task changes as its behavior changes.

;; The look of an object (game/tux.h): its sprite, at a position, in a
;; layer. Gives its index.
func look_new (sprite, x, y, layer) {
    `:number tg_look_new(A_STR_OF($sprite)->s, (float) a_dbl($x), (float) a_dbl($y), (int) $layer.u.i)`
}

;; The layers of the original (`LAYER_OBJECTS`).
val LAYER_OBJECTS = 50

;; A coin: waits for the player, and is collected: it leaves a coin that
;; rises. (`Coin`)
task Coin (life, objs, x, y) {
    val id = obj_new(x, y, 32, 32, COL.TOUCHABLE, KIND.OTHER)
    val sprite = "images/objects/coin/coin.sprite"
    val l = look_new(sprite, x, y, LAYER_OBJECTS - 1)
    `tg_looks[$l.u.i].obj = $id.u.i;`
    set pub = [resp=HIT.ABORT]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
        `tg_look_del($l.u.i);`
    }
    await :hit until (it@0 == PLAYER) && `:boolean tg_touches_player($id.u.i, -0.1f)`
    set status.coins = math.min(status.coins + 1, 9999)
    val px, py = `:number tg_objs[$id.u.i-1]->bbox.x1`, `:number tg_objs[$id.u.i-1]->bbox.y1`
    spawn @objs BouncyCoin(px, py, false, sprite)
}

;; The bonus of the player, as in the original (`BonusType`).
pin BONUS = [NONE=0, GROWUP=1, FIRE=2, ICE=3, AIR=4, EARTH=5]

;; The game time, in seconds (`g_game_time`).
func game_time () {
    `:number tx_game_time`
}

;; The length of the step, in seconds.
func step_dt () {
    `:number tg_dt`
}

;; A field of the data of an object of a tile, a string of the original:
;; `(sprite "images/x.sprite") (data 1)` -> "images/x.sprite", 1.
func tile_field (s, key) {
    val i = string.find(s || "", "(" ++ key ++ " ")
    if i == nil {
        return nil
    }
    val j = string.find(s, ")", i)
    val v = string.sub(s, i + #key + 2, j - 1)
    if string.sub(v, 0, 0) == "\"" => string.sub(v, 1, -2) => (tonumber(v) || v)
}

;; A coin that leaves a bonus block, or a coin that is collected: it
;; rises, and fades out. It is only seen; it does not collide.
;; (`BouncyCoin`)
task BouncyCoin (x, y, emerge, sprite) {
    val t0 = game_time()
    var py = y
    var emerge_distance = if emerge => 32 => 0     ;; the height of its sprite
    val l = look_new(sprite, x, y, LAYER_OBJECTS - 5)
    defer {
        `tg_look_del($l.u.i);`
    }
    ;; `BouncyCoin::draw`: its layer, and its alpha
    val func look () {
        val layer = if emerge_distance > 0 => LAYER_OBJECTS - 5 => LAYER_OBJECTS + 5
        val time_left = 0.5 - (game_time() - t0)
        val alpha = if time_left < 0.2 => time_left / 0.2 => 1
        `tg_looks[$l.u.i].y = (float) a_dbl($py);`
        `tg_looks[$l.u.i].layer = (int) $layer.u.i;`
        `tg_looks[$l.u.i].alpha = (float) a_dbl($alpha);`
    }
    look()
    await :flush
    loop {
        await :update
        val dist = -200 * step_dt()
        set py += dist
        set emerge_distance += dist
        until (game_time() - t0) >= 0.5
        look()
    }
}

;; The contents of a bonus block by the data of its tile
;; (`get_content_by_data`); an invalid one is a coin.
pin BONUS_DATA = ["coin", "coin", "firegrow", "star", "1up", "icegrow",
                  "light", "trampoline", "portabletrampoline", "rock", "rain",
                  "explode", "potion", "airgrow", "earthgrow", "light-on",
                  "retrogrow", "retrostar"]

;; The hits of a bonus block by its type (`get_default_hit_counter`).
pin BONUS_HITS = [orange=3, purple=5]

;; A block (`Block`): an object of the collisions, static, that the player
;; hits from below, and that bounces when hit. Its state is the table `b`:
;; its id, its look, and its bounce.
func block_new (life, task_, x, y, h, sprite) {
    val id = obj_new(x, y, 32, h, COL.STATIC, KIND.OTHER)
    val l = look_new(sprite, x, y, LAYER_OBJECTS + 1)
    `tg_looks[$l.u.i].obj = $id.u.i;`
    set life.byid@id = task_
    [id=id, l=l, original_y=-1, bouncing=false, breaking=false, dir=0]
}

func block_del (life, b) {
    val id, l = b.id, b.l
    set life.byid@id = nil
    `tg_obj_del($id.u.i);`
    `tg_look_del($l.u.i);`
}

;; `Block::start_bounce`, by the player
func block_bounce (b) {
    val id, l = b.id, b.l
    if b.original_y == -1 {
        set b.original_y = `:number tg_obj_y($id.u.i)`
    }
    set b.bouncing = true
    set b.dir = -90
    `tg_looks[$l.u.i].angle = tg_block_angle($id.u.i);`
}

;; `set_action("empty")`: the hitbox of its image
func block_empty (b) {
    val id, l = b.id, b.l
    `tg_look_action($l.u.i, "empty");`
    `tg_obj_size($id.u.i, 32, 32);`
}

;; `Block::update`: the bounce, at each step. Ends when the block breaks
;; (`break_me`), at the top of the bounce of a block that is breaking.
task Block (b) {
    val id, l = b.id, b.l
    loop {
        await :update
        if b.bouncing {
            val dt = step_dt()
            val offset = b.original_y - `:number tg_obj_y($id.u.i)`
            ifs {
                offset > 8 => {
                    set b.dir = 90
                    val d = b.dir
                    `tg_obj_move($id.u.i, 0, (float) a_dbl($d) * (float) a_dbl($dt));`
                    until b.breaking
                }
                (offset < (90 * dt)) && (b.dir > 0) => {
                    `tg_obj_move($id.u.i, 0, (float) a_dbl($offset));`
                    set b.dir = 0
                    set b.bouncing = false
                    `tg_looks[$l.u.i].angle = 0;`
                }
                else => {
                    val d = b.dir
                    `tg_obj_move($id.u.i, 0, (float) a_dbl($d) * (float) a_dbl($dt));`
                }
            }
        }
    }
}

;; What a block does to another object that touches it while it bounces
;; (`Block::collision`): an egg above it jumps.
func block_other (life, b, other, bits) {
    if b.bouncing && ((bits & HIT.SIDES) != 0) {
        val t = life.byid@other
        val id = b.id
        if t && (t.pub.kind == :growup) &&
           `:boolean tx_rect_bottom(&tg_objs[$other.u.i-1]->bbox) < tx_rect_top(&tg_objs[$id.u.i-1]->bbox) + TX_SHIFT_DELTA`
        {
            `TG_PHYS($other.u.i).vy = -300;`     ;; `GrowUp::do_jump`
        }
    }
}

;; A powerup that rises out of a bonus block (`SpecialRiser`): the looks
;; `ls` of the object it carries are drawn moved up by `offset`, which
;; grows by 50 per second, until it passes 32. As every object, it enters
;; the sector at the end of the step in which it is created. Then the
;; object enters the sector, at the end of the step in which it ends.
task Riser (ls) {
    var offset = 0
    val func move () {
        loop _,l in ls {
            `tg_looks[$l.u.i].ty = -32.0f + (float) a_dbl($offset);`
        }
    }
    move()
    await :flush
    loop {
        await :update
        set offset += 50 * step_dt()
        until offset > 32
        move()
    }
    loop _,l in ls {
        `tg_looks[$l.u.i].ty = 0;`
    }
}

;; An egg (`GrowUp`): it rises out of the block at `x`, `y`, rolls to the
;; side away from the player, and makes him big.
task GrowUp (life, x, y, left) {
    val sprite = "images/powerups/egg/egg.sprite"
    val px, py = x, y - 32
    val l  = look_new(sprite, px, py, LAYER_OBJECTS)
    val sh = look_new(sprite, px, py, LAYER_OBJECTS)
    `tg_look_action($sh.u.i, "shadow");`
    `tg_looks[$l.u.i].angle = (float) a_dbl($px) * 360.0f / (32.0f * 3.14159265358979323846f);`
    defer {
        `tg_look_del($l.u.i);`
        `tg_look_del($sh.u.i);`
    }
    await Riser([l, sh])

    val id = obj_new(px, py, 32, 32, COL.MOVING, KIND.OTHER)
    `tg_looks[$l.u.i].obj = $id.u.i;`
    `tg_looks[$sh.u.i].obj = $id.u.i;`
    `TG_PHYS($id.u.i).vx = a_truthy($left) ? -100.0f : 100.0f;`
    set pub = [resp=HIT.FORCE, kind=:growup]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
    }

    ;; `GrowUp::collision_solid`
    val func solid (bits) {
        if (bits & HIT.TOP) != 0 {
            `TG_PHYS($id.u.i).vy = 0;`
        }
        if ((bits & HIT.BOTTOM) != 0) && `:boolean TG_PHYS($id.u.i).vy > 0` {
            `TG_PHYS($id.u.i).vy = 0;`
        }
        val vx = `:number TG_PHYS($id.u.i).vx`
        if ((bits & HIT.FLAT) != 0) &&
           ((((bits & HIT.LEFT) != 0) && (vx < 0)) || (((bits & HIT.RIGHT) != 0) && (vx > 0)))
        {
            `TG_PHYS($id.u.i).vx = -TG_PHYS($id.u.i).vx;`
            `TG_PHYS($id.u.i).ax = -TG_PHYS($id.u.i).ax;`
        }
    }

    par :any {
        loop e on :solid {
            solid(e@0)
        }
    } with {
        ;; `GrowUp::collision`
        loop e on :hit {
            if e@0 == PLAYER {
                set pub.resp = HIT.ABORT
                until `:boolean tx_player_add_bonus(&tg_tux, TX_BONUS_GROWUP, 1)`
                solid(e@1)          ;; Tux cannot grow now
            } else {
                set pub.resp = HIT.FORCE
            }
        }
    } with {
        ;; `GrowUp::update`
        loop on :update {
            `if (TG_PHYS($id.u.i).vx != 0) tg_looks[$l.u.i].angle = tg_objs[$id.u.i-1]->bbox.x1 * 360.0f / (32.0f * 3.14159265358979323846f);`
            `tg_obj_physic_move($id.u.i);`
        }
    }
}

;; The sprites of the flowers, by bonus.
pin FLOWERS = [
    @(BONUS.FIRE)  = "images/powerups/fireflower/fireflower.sprite",
    @(BONUS.ICE)   = "images/powerups/iceflower/iceflower.sprite",
    @(BONUS.AIR)   = "images/powerups/airflower/airflower.sprite",
    @(BONUS.EARTH) = "images/powerups/earthflower/earthflower.sprite",
]

;; A flower (`Flower`): it rises out of the block at `x`, `y`, and waits
;; for the player, to give him its bonus.
task Flower (life, x, y, bonus) {
    val px, py = x, y - 32
    val l = look_new(FLOWERS@bonus, px, py, LAYER_OBJECTS)
    defer {
        `tg_look_del($l.u.i);`
    }
    await Riser([l])

    val id = obj_new(px, py, 32, 32, COL.TOUCHABLE, KIND.OTHER)
    set pub = [resp=HIT.ABORT, kind=:flower]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
    }
    loop e on :hit {
        if e@0 == PLAYER {
            set pub.resp = HIT.ABORT
            until `:boolean tx_player_add_bonus(&tg_tux, (int) $bonus.u.i, 1)`
            set pub.resp = HIT.FORCE
        } else {
            set pub.resp = HIT.ABORT
        }
    }
}

;; The bonus of the contents of a bonus block that raise a powerup.
pin GROWS = [firegrow=BONUS.FIRE, icegrow=BONUS.ICE, airgrow=BONUS.AIR, earthgrow=BONUS.EARTH]

;; A bonus block (`BonusBlock`): the player hits it from below, and it
;; gives what it has, and bounces. `o` has its `contents` (as the strings
;; of the original), `hits` (0 is infinite), `script`, `sprite`, and the
;; height `h` of its box: 32.1, as `Block` makes it, or 32, the hitbox of
;; its sprite, when the type of the block changes the sprite
;; (`MovingSprite::on_type_change`). The images of the blocks are all of
;; 32x32.
task BonusBlock (life, objs, scripts, env, x, y, o) {
    pin b = block_new(life, task, x, y, o.h, o.sprite)
    set pub = [resp=HIT.FORCE, empty=false]
    defer {
        block_del(life, b)
    }
    var hits = o.hits

    ;; `BonusBlock::try_open`, by the player
    val func try_open () {
        if !pub.empty {
            match o.contents {
                "coin" => {
                    val id = b.id
                    spawn @objs BouncyCoin(x, `:number tg_obj_y($id.u.i)`, true, "images/objects/coin/coin.sprite")
                    set status.coins = math.min(status.coins + 1, 9999)
                }
                "script" => nil
                else => {
                    val bonus = GROWS@(o.contents)
                    if bonus {
                        ;; `raise_growup_bonus`, away from the player
                        val id = b.id
                        val left = `:boolean tx_rect_middle(&tg_tux.col.bbox).x > tx_rect_middle(&tg_objs[$id.u.i-1]->bbox).x`
                        if `:boolean tg_tux.bonus == TX_BONUS_NONE` {
                            spawn @objs GrowUp(life, x, `:number tg_obj_y($id.u.i)`, left)
                        } else {
                            spawn @objs Flower(life, x, `:number tg_obj_y($id.u.i)`, bonus)
                        }
                    } else {
                        val c = o.contents
                        `fprintf(stderr, "bonus block: contents not done: %s\n", A_STR_OF($c)->s);`
                    }
                }
            }
            if o.script {
                spawn @scripts script.Script(env, o.script, "BonusBlockScript")
            }
            block_bounce(b)
            ifs {
                hits <= 0 => nil        ;; infinite
                hits == 1 => {
                    set pub.empty = true
                    block_empty(b)
                }
                else      => set hits -= 1
            }
        }
    }

    par {
        loop e on :hit {
            if e@0 == PLAYER {
                val id, bits = b.id, e@1
                val r = `:number tg_block_player($id.u.i, (int) $bits.u.i)`
                ;; a drop (`try_drop`) of a coin opens it, as a hit
                if (r & 5) != 0 {
                    try_open()
                }
                if (r & 2) != 0 {
                    try_open()
                }
            } else {
                block_other(life, b, e@0, e@1)
            }
        }
    } with {
        await Block(b)
    }
}

;; A particle that is a sprite (`SpriteParticle`), with no timeout: it
;; moves by its velocity and acceleration, until the animation of its
;; action ends (once), or it leaves the view of the camera. `x`, `y` is its
;; middle (`ANCHOR_MIDDLE`); `w`, `h` the hitbox of the action. The
;; animation is the one of an action of one frame at `fps`, which the
;; sprite advances when it is drawn, after each step.
task SpriteParticle (sprite, action, x, y, w, h, vx, vy, ax, ay, layer, fps) {
    var px = x - (0 + ((w - 0) / 2))
    var py = y - (0 + ((h - 0) / 2))
    var vx_, vy_ = vx, vy
    val l = look_new(sprite, px, py, layer)
    `tg_look_action_loops($l.u.i, A_STR_OF($action)->s, 1);`
    defer {
        `tg_look_del($l.u.i);`
    }
    var frame = 0
    var last = game_time()
    await :flush
    loop {
        await :update
        until frame >= 1               ;; `sprite->animation_done()`
        val dt = step_dt()
        set px += vx_ * dt
        set py += vy_ * dt
        set vx_ += ax * dt
        set vy_ += ay * dt
        until !`:boolean tg_cam_contains((float) a_dbl($px), (float) a_dbl($py))`
        `tg_looks[$l.u.i].x = (float) a_dbl($px);`
        `tg_looks[$l.u.i].y = (float) a_dbl($py);`
        ;; `Sprite::update`, when it is drawn after the step
        val now = game_time()
        set frame += fps * (now - last)
        set last = now
    }
}

;; `Block::break_me`: six pieces of its sprite fly (the vertical speed is
;; drawn first, as the official build evaluates the arguments of the
;; vector), and the block is gone.
func block_break (objs, b, sprite) {
    val id = b.id
    val x = `:number tg_objs[$id.u.i-1]->bbox.x1 + 16.0f`
    val y = `:number tg_objs[$id.u.i-1]->bbox.y1 + 16.0f`
    val gravity = `:number tg_sec.gravity * 100`
    loop _,act in ["piece1", "piece2", "piece3", "piece4", "piece5", "piece6"] {
        val vy = `:number tr_randf(&tg_grand, -400, -300)`
        val vx = `:number tr_randf(&tg_grand, -100, 100)`
        spawn @objs SpriteParticle(sprite, act, x, y, 32, 32, vx, vy, 0, gravity, LAYER_OBJECTS + 1, 1)
    }
}

;; A brick (`Brick`): it has 5 coins and then is empty, or it breaks, when
;; the player is big (when small, it only bounces). `o` has `breakable`,
;; `sprite`, and `h`, as a bonus block.
task Brick (life, objs, x, y, o) {
    pin b = block_new(life, task, x, y, o.h, o.sprite)
    set pub = [resp=HIT.FORCE]
    defer {
        block_del(life, b)
    }
    var empty = false
    var coins = if o.breakable => 0 => 5

    ;; `Brick::try_break`, by the player
    val func try_break () {
        if !empty {
            ifs {
                coins > 0 => {
                    val id = b.id
                    spawn @objs BouncyCoin(x, `:number tg_obj_y($id.u.i)`, true, "images/objects/coin/coin.sprite")
                    set coins -= 1
                    set status.coins = math.min(status.coins + 1, 9999)
                    if coins == 0 {
                        set empty = true
                        block_empty(b)
                    }
                    block_bounce(b)
                }
                o.breakable => {
                    block_bounce(b)
                    if `:boolean tx_player_is_big(&tg_tux)` {
                        set b.breaking = true       ;; `start_break`
                    }
                }
            }
        }
    }

    par :any {
        loop e on :hit {
            if e@0 == PLAYER {
                val id, bits = b.id, e@1
                val r = `:number tg_block_player($id.u.i, (int) $bits.u.i)`
                if (r & 1) != 0 {
                    try_break()
                }
                if (r & 2) != 0 {
                    try_break()          ;; `Brick::hit`
                }
            } else {
                block_other(life, b, e@0, e@1)
            }
        }
    } with {
        await Block(b)                  ;; it breaks: `break_me`
        block_break(objs, b, o.sprite)
    }
}

;; A bonus block of a level, as its fields give it.
func bonus_of_level (o) {
    var c = "coin"
    if o.data != nil {
        set c = BONUS_DATA@(o.data) || "coin"
    }
    if o.contents {
        set c = o.contents
    }
    val spr = if o.type => ("images/objects/bonus_block/" ++ o.type ++ "block.sprite")
                        => "images/objects/bonus_block/bonusblock.sprite"
    [contents=c, hits=o.count || BONUS_HITS@(o.type) || 1,
     script=o.script, sprite=o.sprite || spr, h=if o.sprite => 32.1 => 32]
}

;; A bonus block of a tile, as its data gives it.
func bonus_of_tile (d) {
    [contents=BONUS_DATA@(tile_field(d, "data") || 0) || "coin", hits=1,
     sprite=tile_field(d, "sprite") || "images/objects/bonus_block/bonusblock.sprite",
     h=if tile_field(d, "sprite") => 32.1 => 32]
}

;; A brick of a level, as its fields give it.
func brick_of_level (o) {
    [breakable=(o.breakable != false),
     sprite=o.sprite || "images/objects/bonus_block/brick.sprite", h=if o.sprite => 32.1 => 32]
}

;; A brick of a tile, as its data gives it.
func brick_of_tile (d) {
    val spr = tile_field(d, "sprite")
    [breakable=(tile_field(d, "breakable") != "#f"),
     sprite=spr || "images/objects/bonus_block/brick.sprite", h=if spr => 32.1 => 32]
}

;; The player, as the scripts see it (`Player::register_class`). Each
;; method receives the vector of its arguments.
pin TUX = [
    walk = func (a) {
        val x = a@0
        `tx_player_walk(&tg_tux, (float) a_dbl($x));`
    },
    set_velocity = func (a) {
        val x, y = a@0, a@1
        `tx_player_set_velocity(&tg_tux, (float) a_dbl($x), (float) a_dbl($y));`
    },
    get_velocity_x = func (a) { `:number tg_tux.physic.vx` },
    get_velocity_y = func (a) { `:number tg_tux.physic.vy` },
    do_jump = func (a) {
        val y = a@0
        `tx_player_do_jump(&tg_tux, (float) a_dbl($y));`
    },
    do_duck     = func (a) { `tx_player_do_duck(&tg_tux);` },
    do_backflip = func (a) { `tx_player_do_backflip(&tg_tux);` },
    do_cheer    = func (a) { `tx_player_do_cheer(&tg_tux);` },
    activate    = func (a) { `tx_player_activate(&tg_tux);` },
    deactivate  = func (a) { `tx_player_deactivate(&tg_tux);` },
    set_dir = func (a) {
        val r = script.truthy(a@0)
        `tx_player_set_dir(&tg_tux, a_truthy($r));`
    },
    kill = func (a) {
        val c = script.truthy(a@0)
        `tx_player_kill(&tg_tux, a_truthy($c));`
    },
    use_scripting_controller = func (a) {
        val yes = script.truthy(a@0)
        `tx_player_use_scripting_controller(&tg_tux, a_truthy($yes));`
    },
    do_scripting_controller = func (a) {
        val c = CONTROLS@(a@0)
        val yes = script.truthy(a@1)
        if c != nil {
            `tx_player_do_scripting_controller(&tg_tux, (int) $c.u.i, a_truthy($yes));`
        }
    },
    add_coins = func (a) {
        set status.coins = math.min(status.coins + a@0, 9999)
    },
    get_coins = func (a) { status.coins },
    trigger_sequence = func (a) {
        val seq = SEQS@(a@0)
        if seq != nil {
            `tx_player_trigger_sequence(&tg_tux, (int) $seq.u.i, NULL);`
        }
    },
]

;; The touch of a trigger by the player (`TriggerBase`): calls `f` when the
;; player starts to touch it. The player touches it in the collisions of a
;; step, and stops touching it at the update of a step with no collision
;; since the update before.
task Touch (f) {
    loop {
        await :hit until it@0 == PLAYER
        f()
        loop {
            await :update
            val again = par :any {
                await :update
                false
            } with {
                await :hit until it@0 == PLAYER
                true
            }
            while again
        }
    }
}

;; The part of a trigger that every trigger has: its object of the
;; collisions, which the player touches. Gives the id.
func trigger_new (life, o) {
    obj_new(o.x, o.y, o.width || 32, o.height || 32, COL.TOUCHABLE, KIND.TRIGGER)
}

;; A trigger that runs a script, when the player touches it, or when he
;; presses up in it (a "button"). (`ScriptTrigger`) He presses up in it in
;; his own collision with it, which reaches the trigger as `:activate`.
task ScriptTrigger (life, scripts, env, o) {
    val id = trigger_new(life, o)
    set pub = [resp=HIT.ABORT]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
    }
    val mine = if o.button => EVENT.ACTIVATE => EVENT.TOUCH
    var runs = 0
    val func event (ev) {
        if (ev == mine) && !(o.oneshot && (runs >= 1)) {
            set runs += 1
            spawn @scripts script.Script(env, o.script, "ScriptTrigger")
        }
    }
    par {
        await Touch(\{ event(EVENT.TOUCH) })
    } with {
        loop on :activate {
            event(EVENT.ACTIVATE)
        }
    }
}

;; A trigger that starts a sequence when the player touches it: the end of
;; the level, or the stop of Tux at its end. (`SequenceTrigger`)
task SequenceTrigger (life, o) {
    val id = trigger_new(life, o)
    set pub = [resp=HIT.ABORT]
    set life.byid@id = task
    defer {
        set life.byid@id = nil
        `tg_obj_del($id.u.i);`
    }
    val seq = if o.sequence => SEQS@(o.sequence) => SEQ.END
    await Touch(\{
        `tx_player_trigger_sequence(&tg_tux, (int) $seq.u.i, NULL);`
    })
}

;; The end of a level, Tux walks out (`EndSequenceWalk`). It moves as an
;; object of the sector, after the others, or alone, when Tux was stopped.
;; As every object, it enters the sector at the end of the step in which
;; it is created (`:flush`), and moves from the next step on.
task EndSequenceWalk (life) {
    await :flush
    loop {
        await <:update || :endseq>
        if `:boolean tg_end_running()` {
            set life.done = true
        }
    }
}

include "badguy.atm"

;; A life in a level: from the spawn of Tux to his death (`:dead`).
;; (`GameSession::restart_level` up to the next one.)

;; `cont` is true when the life starts in the middle of a step, at the
;; restart of the level after a death (`check_end_conditions`). It gives
;; :restart at a death, and :won at the end of the level.
task Life (lvl, ts, cont, n) {
    do {
        val n = ts.max + 1
        `tg_sector($n.u.i);`
        loop id,a in ts.attrs {
            val d = ts.datas@id
            `tg_sec.tiles.attrs[$id.u.i] = $a.u.i;`
            `tg_sec.tiles.data[$id.u.i]  = $d.u.i;`
        }
        loop id,_ in ts.objs {
            `tg_objtile[$id.u.i] = 1;`
        }
    }
    defer {
        `tg_sector_free();`
    }

    pin objs = tasks()
    pin life = [byid=[], endseq=false, running=false, done=false, stopped=false, n=n]
    ```
    tg_cb_st = A_OK;
    ```
    val func dispatch (self, other, bits) {
        val t = life.byid@self
        if t {
            emit @t :hit [other, bits]
            t.pub.resp
        } else {
            HIT.ABORT
        }
    }
    `tg_dispatch = $dispatch;`
    val func trigger (self, ev) {
        val t = life.byid@self
        if t {
            emit @t :activate [ev]
        }
    }
    `tg_trigger = $trigger;`
    val func solid (self, bits, nx, ny) {
        val t = life.byid@self
        if t {
            emit @t :solid [bits, nx, ny]
        }
    }
    `tg_solid = $solid;`
    val func tile (self, attrs) {
        val t = life.byid@self
        if t {
            emit @t :tile [attrs]
        }
    }
    `tg_tile = $tile;`

    ;; `GameSession::start_sequence`
    val func sequence (seq) {
        if seq == SEQ.STOPTUX {
            if !life.endseq {
                sequence(SEQ.END)
            }
            if life.endseq {
                set life.stopped = true
                `tg_end_stopped = 1;`
            }
        } else {
            `tx_player_set_winning(&tg_tux);`
            if !life.running {
                if !life.endseq && (seq == SEQ.END) {
                    set life.endseq = true
                    spawn @objs EndSequenceWalk(life)
                }
                if life.endseq {
                    `tg_end_prepare();`
                    set life.running = true
                    `tg_end_start();`
                }
            }
        }
    }
    `tg_sequence = $sequence;`

    ;; the scripts of this life, and what they see
    pin scripts = tasks()
    pin env = [
        objects = [Tux=TUX],
        funcs   = [],
        globals = [state=status.state],
    ]

    var x, y
    var init
    loop _,s in lvl {
        if (type(s) == :table) && (s.tag == :sector) && (s.name == "main") {
            set init = s.init_script
            loop k,o in s {
                if (type(k) == :number) && (type(o) == :table) {
                    if (o.tag == :tilemap) && o.solid {
                        val w, h, tiles = o.width, o.height, o.tiles
                        val ox, oy = map_offset(s, o)
                        `tg_map($tiles, $w.u.i, $h.u.i);`
                        `tg_sec.maps[tg_sec.maps_n-1]->offset = tx_vec((float) a_dbl($ox), (float) a_dbl($oy));`
                    }
                    if (o.tag == :spawnpoint) && (o.name == "main") {
                        set x, y = o.x, o.y
                    }
                    if BADGUYS@(o.tag) {
                        spawn @objs BadGuy(life, objs, o, BADGUYS@(o.tag), uid_of(life, k))
                    }
                    match o.tag {
                        :coin          => spawn @objs Coin(life, objs, o.x, o.y)
                        :scripttrigger   => spawn @objs ScriptTrigger(life, scripts, env, o)
                        :sequencetrigger => spawn @objs SequenceTrigger(life, o)
                        :brick           => spawn @objs Brick(life, objs, o.x, o.y, brick_of_level(o))
                        :bonusblock      => spawn @objs BonusBlock(life, objs, scripts, env, o.x, o.y, bonus_of_level(o))
                        else           => nil
                    }
                }
            }
        }
    }
    `tg_keys_reset();`

    ;; the tiles that are objects (`Sector::convert_tiles2gameobject`)
    `tg_convert_start();`
    loop {
        val id = `:number tg_convert_next()`
        until id == 0
        val tx, ty = `:number tg_conv_px`, `:number tg_conv_py`
        match ts.objs@id@0 {
            "coin"       => spawn @objs Coin(life, objs, tx, ty)
            "bonusblock" => spawn @objs BonusBlock(life, objs, scripts, env, tx, ty, bonus_of_tile(ts.objs@id@1))
            "brick"      => spawn @objs Brick(life, objs, tx, ty, brick_of_tile(ts.objs@id@1))
        }
    }

    `tg_flush();`
    `tg_player((float)a_dbl($x), (float)a_dbl($y));`

    ;; the sector is ready: the view, if any, builds what it draws
    emit @:global :sector

    ;; `Sector::activate` runs the init script, up to its first wait
    if init {
        spawn @scripts script.Script(env, init, "init-script")
    }

    ;; the steps: `GameSession::update`
    var first = cont
    var finishing = false
    val r = loop {
        if !first {
            val e = await :step
            `tg_step_begin();`
            loop _,k in e {
                if type(k) == :table {
                    val c, v = k@0, k@1
                    `tg_key($c.u.i, $v.u.i);`
                }
            }
            ;; `check_end_conditions`
            if life.done {
                set finishing = true
            } else {
                if !life.endseq && `:boolean tg_tux.dead` {
                    break :restart
                }
            }
        }
        set first = false

        if life.running && life.stopped {
            ;; Tux is stopped: only the sequence moves
            emit :endseq
        } else {
            ;; `Sector::update`: the scripts, the objects, the collisions
            emit :scripts
            `tg_step_player();`
            emit :update
            ```
            tg_step_end();
            if (tg_cb_st != A_OK) {
                st = tg_cb_st;
            }
            ```
            emit :flush
        }
        emit @:global :stepped
        until finishing, :won
    }
    r
}

task Session (path) {
    pin lvl = data.load(path)
    pin ts  = data.tileset("/images/tiles.strf")
    var cont = false
    var n = 0
    loop {
        set n += 1
        val r = await Life(lvl, ts, cont, n)
        until r == :won
        set cont = true
    }
}
