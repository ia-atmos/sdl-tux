;; The view of a sector: what is drawn, and its images (game/draw.h).
;;
;; At each life, the session emits `:sector`, once its tilemaps are
;; built; the view then builds its list of drawables, in the order of the
;; objects of the sector, and loads the images of the tiles in use. Then
;; it draws at each frame, with the translation of the camera.
;;
;; The images come from the data of the official game:
;; $TUX_ASSETS (default: ../official/supertux/data).

```:prelude
#include "game/draw.h"
```

pin view = [
    assets = os.getenv("TUX_ASSETS") || "../official/supertux/data",
    imgs   = [],        ;; path -> image
    sprs   = [],        ;; path -> the data of a sprite (TsData, in C)
    index  = [],        ;; path -> index, for game/draw.h
    n      = 0,
]

;; The index of an image of the data, by its path in the data
;; (`images/tiles/...`), loaded once.
func view.image (path) {
    if view.index@path == nil {
        set view.imgs@path = sdl.image(view.assets ++ "/" ++ path)
        set view.index@path = view.n
        set view.n += 1
    }
    val i, img = view.index@path, view.imgs@path
    if img {
        `td_img((int) $i.u.i, $img);`
    }
    i
}

;; A color of the level: [r, g, b] or [r, g, b, a].
func view.color (c, d) {
    if c => (c@0, c@1, c@2, c@3 || 1) => (d, d, d, d)
}

;; The tiles of the tileset in use, with their frames (`TileSetParser`).
func view.tiles (raw) {
    loop _,t in raw {
        if type(t) == :table {
            match t.tag {
                :tile => {
                    val id = t.id
                    if `:boolean td_is_used((int) $id.u.i)` {
                        val fps = t.fps || 10
                        `td_tile((int) $id.u.i, (float) a_dbl($fps));`
                        val func frame (im) {
                            val path, x, y, w, h = if type(im) == :table => (im@0, im@1, im@2, im@3, im@4) => (im, 0, 0, nil, nil)
                            val i = view.image("images/" ++ path)
                            val img = view.imgs@("images/" ++ path)
                            val iw, ih = sdl.size(img)
                            val fw, fh = w || iw, h || ih
                            `td_frame((int) $id.u.i, (int) $i.u.i, (int) a_dbl($x), (int) a_dbl($y), (int) a_dbl($fw), (int) a_dbl($fh));`
                        }
                        ifs {
                            t.images == nil  => nil
                            t.images.region  => frame(t.images.region)
                            else => {
                                loop _,im in t.images {
                                    frame(im)
                                }
                            }
                        }
                    }
                }
                :tiles => {
                    val off = t.offset || 0
                    val fps = t.fps || 10
                    loop k,id0 in t.ids {
                        val id = id0 + off
                        if (id0 != 0) && `:boolean td_is_used((int) $id.u.i)` {
                            `td_tile((int) $id.u.i, (float) a_dbl($fps));`
                            val x, y = 32 * (k % t.width), 32 * (k // t.width)
                            val imgs = t.images || t.image
                            if imgs {
                                loop _,path in imgs {
                                    val i = view.image("images/" ++ path)
                                    `td_frame((int) $id.u.i, (int) $i.u.i, (int) $x.u.i, (int) $y.u.i, 32, 32);`
                                }
                            }
                        }
                    }
                }
                else => nil
            }
        }
    }
}

;; A sprite of the data (`images/...sprite`) into a TsData of C, at `ptr`
;; (`SpriteData::parse_action`): images and mirror actions only.
func view.sprite (dir, file, ptr) {
    val spr = data.load("/" ++ dir ++ file)
    loop _,a in spr {
        if (type(a) == :table) && (a.tag == :action) {
            assert(!a.flip_action && !a.clone_action && !a.regions, "sprite: not supported in " ++ file)
            val name = a.name
            val nhit = if a.hitbox => #a.hitbox => 0
            val h0, h1, h2, h3 = if a.hitbox => (a.hitbox@0 || 0, a.hitbox@1 || 0, a.hitbox@2 || 0, a.hitbox@3 || 0) => (0, 0, 0, 0)
            val hf, fps = (a.fps != nil), (a.fps || 0)
            val hl, loops = (a.loops != nil), (a.loops || 0)
            val hlf, lf = (a.loop_frame != nil), (a.loop_frame || 0)
            val fam = a.family_name
            ```
            float hit[4] = { a_dbl($h0), a_dbl($h1), a_dbl($h2), a_dbl($h3) };
            TsAction* act = ts_action((TsData*) a_nat_ptr($ptr) , A_STR_OF($name)->s, (int) $nhit.u.i, hit,
                a_truthy($hf), (float) a_dbl($fps), a_truthy($hl), (int) a_dbl($loops),
                a_truthy($hlf), (int) a_dbl($lf), ($fam.type == A_STR) ? A_STR_OF($fam)->s : NULL);
            ```
            if a.mirror_action {
                val other = a.mirror_action
                `ts_mirror((TsData*) a_nat_ptr($ptr), act, A_STR_OF($other)->s);`
            } else {
                if a.images {
                    val n = #a.images
                    ```
                    int* imgs = malloc($n.u.i * sizeof(int));
                    int* ws = malloc($n.u.i * sizeof(int));
                    int* hs = malloc($n.u.i * sizeof(int));
                    ```
                    loop k,f in a.images {
                        val i = view.image(dir ++ f)
                        val iw, ih = sdl.size(view.imgs@(dir ++ f))
                        `imgs[$k.u.i] = (int) $i.u.i; ws[$k.u.i] = (int) a_dbl($iw); hs[$k.u.i] = (int) a_dbl($ih);`
                    }
                    ```
                    ts_images((TsData*) a_nat_ptr($ptr), act, imgs, ws, hs, (int) $n.u.i);
                    free(imgs); free(ws); free(hs);
                    ```
                }
            }
        }
    }
}

;; The data of a sprite of the data (`images/...sprite`, or an image), once.
func view.data (path) {
    val p = if string.sub(path, 0, 0) == "/" => string.sub(path, 1) => path
    if view.sprs@p == nil {
        set view.sprs@p = `:value a_nat(calloc(1, sizeof(TsData)), free, "TsData")`
        val d = view.sprs@p
        if string.find(p, ".sprite") {
            val parts = string.split(p, "/")
            val file = parts@#
            val dir = string.sub(p, 0, #p - #file - 1)
            view.sprite(dir, file, d)
        } else {
            val i = view.image(p)
            val w, h = sdl.size(view.imgs@p)
            `ts_from_image((TsData*) a_nat_ptr($d), (int) $i.u.i, (int) a_dbl($w), (int) a_dbl($h));`
        }
    }
    view.sprs@p
}

;; The drawables of a sector, in the order of its objects.
func view.build (sec, raw, ntiles) {
    `td_reset((int) $ntiles.u.i);`
    `td_item(TD_PLAYER, 0, 51);`         ;; the player is the first object
    var foremost = -300                  ;; Sector::calculate_foremost_layer

    var solid = 0
    loop _,o in sec {
        if type(o) == :table {
            match o.tag {
                :tilemap => {
                    val w, h = o.width, o.height
                    val z = o.z_pos || 0
                    val sx = o.speed_x || o.speed || 1
                    val sy = o.speed_y || o.speed || sx
                    val alpha = o.alpha || 1
                    val r, g, b, a = view.color(o.tint, 1)
                    val ox, oy = map_offset(sec, o)
                    if z > foremost {
                        set foremost = if alpha < 1 => z - 1 => z + 1
                    }
                    if o.solid {
                        `td_map(tg_sec.maps[$solid.u.i]->tiles, 0, $w.u.i, $h.u.i, (int) a_dbl($z), 1, 1, (float) a_dbl($alpha), (float) a_dbl($r), (float) a_dbl($g), (float) a_dbl($b), (float) a_dbl($a));`
                        set solid += 1
                    } else {
                        val tiles = o.tiles
                        `td_map(tg_tiles($tiles, $w.u.i * $h.u.i), 1, $w.u.i, $h.u.i, (int) a_dbl($z), (float) a_dbl($sx), (float) a_dbl($sy), (float) a_dbl($alpha), (float) a_dbl($r), (float) a_dbl($g), (float) a_dbl($b), (float) a_dbl($a));`
                    }
                    `td_maps[td_maps_n-1].offset = tx_vec((float) a_dbl($ox), (float) a_dbl($oy));`
                }
                :background => {
                    val func img (p) {
                        if p => view.image(if string.sub(p, 0, 0) == "/" => string.sub(p, 1) => p) => -1
                    }
                    val main = img(o.image || "images/background/misc/transparent_up.png")
                    val top, bot = img(o.image_top), img(o.image_bottom)
                    val al = match o.alignment {
                        "left"   => `:number TD_LEFT_ALIGNMENT`
                        "right"  => `:number TD_RIGHT_ALIGNMENT`
                        "top"    => `:number TD_TOP_ALIGNMENT`
                        "bottom" => `:number TD_BOTTOM_ALIGNMENT`
                        else     => `:number TD_NO_ALIGNMENT`
                    }
                    val z = o.z_pos || -300
                    val spx = o.speed_x || o.speed || 0.5
                    val spy = o.speed_y || spx
                    val ssx, ssy = o.scroll_speed_x || 0, o.scroll_speed_y || 0
                    val ox = (o.scroll_offset_x || 0) + (o.x || 0)
                    val oy = (o.scroll_offset_y || 0) + (o.y || 0)
                    val c0, c1, c2, c3 = view.color(o.color, 1)
                    ```
                    float c[4] = { a_dbl($c0), a_dbl($c1), a_dbl($c2), a_dbl($c3) };
                    td_background((int) $top.u.i, (int) $main.u.i, (int) $bot.u.i, (int) $al.u.i, (int) a_dbl($z),
                                  (float) a_dbl($spx), (float) a_dbl($spy), (float) a_dbl($ssx), (float) a_dbl($ssy),
                                  (float) a_dbl($ox), (float) a_dbl($oy), c);
                    ```
                }
                :decal => {
                    val d = view.data(o.sprite || "images/decal/explanations/billboard-bigtux.png")
                    val x, y, z = o.x || 0, o.y || 0, o.z_pos || 50
                    val act = o.action
                    ```
                    TsSprite* s = td_sprite((TsData*) a_nat_ptr($d), (float) a_dbl($x), (float) a_dbl($y), (int) a_dbl($z));
                    if ($act.type == A_STR) ts_set_action(s, A_STR_OF($act)->s, -1);
                    ```
                }
                :gradient => {
                    val t0, t1, t2, t3 = view.color(o.top_color, 0)
                    val b0, b1, b2, b3 = view.color(o.bottom_color, 0)
                    val dir = match o.direction {
                        "horizontal"        => `:number TD_HORIZONTAL`
                        "horizontal_sector" => `:number TD_HORIZONTAL_SECTOR`
                        "vertical_sector"   => `:number TD_VERTICAL_SECTOR`
                        else                => `:number TD_VERTICAL`
                    }
                    val z = o.z_pos || -300
                    ```
                    float top[4] = { a_dbl($t0), a_dbl($t1), a_dbl($t2), a_dbl($t3) };
                    float bot[4] = { a_dbl($b0), a_dbl($b1), a_dbl($b2), a_dbl($b3) };
                    td_gradient(top, bot, (int) $dir.u.i, (int) a_dbl($z));
                    ```
                }
                else => nil
            }
        }
    }
    view.tiles(raw)
    `tp_layer_dying = (int) $foremost.u.i + 1;`
}

;; The view of a level: rebuilt at each life, drawn at each frame.
task View (path) {
    ;; the sprite of Tux, once (its images stay loaded)
    pin tux = `:value a_nat(&tp_data, NULL, "tp_data")`
    view.sprite("images/creatures/tux/", "tux.sprite", tux)
    ```
    tp_ready = 1;
    tg_extra_hooks = tp_hooks;
    ```
    pin lvl = data.load(path)
    pin raw = data.load("/images/tiles.strf")
    var sec
    loop _,s in lvl {
        if (type(s) == :table) && (s.tag == :sector) && (s.name == "main") {
            set sec = s
        }
    }
    par {
        loop on :sector {
            val n = `:number tg_sec.tiles.count`
            view.build(sec, raw, n)
        }
    } with {
        loop on :stepped {
            `td_update(tg_dt);`
        }
    } with {
        loop on :draw {
            `td_draw(tg_cam.translation);`
        }
    }
}
