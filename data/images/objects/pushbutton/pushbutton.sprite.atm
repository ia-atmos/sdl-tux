:supertux.sprite [
    :action [
        name = "off-up",
        hitbox = [0, 0, 30, 16],
        images = ["pushbutton-0.png"],
        size = [32, 16],
    ],
    :action [
        name = "on-up",
        hitbox = [0, 0, 30, 10],
        loops = 1,
        fps = 20,
        images = ["pushbutton-1.png", "pushbutton-2.png", "pushbutton-3.png"],
        size = [32, 10],
    ],
    :action [
        name = "off-down",
        hitbox = [0, 0, 30, 16],
        flip_action = "off-up",
    ],
    :action [name = "on-down", hitbox = [0, 0, 30, 10], flip_action = "on-up"],
]
