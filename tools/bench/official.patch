diff --git a/src/supertux/tuxtest.cpp b/src/supertux/tuxtest.cpp
new file mode 100644
index 0000000..8d300d5
--- /dev/null
+++ b/src/supertux/tuxtest.cpp
@@ -0,0 +1,204 @@
+// Test mode for the port to Atmos (ia-atmos/sdl-tux). See tuxtest.hpp.
+
+#include "supertux/tuxtest.hpp"
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "badguy/badguy.hpp"
+#include "control/controller.hpp"
+#include "object/player.hpp"
+#include "supertux/game_session.hpp"
+#include "supertux/player_status.hpp"
+#include "supertux/sector.hpp"
+#include "object/camera.hpp"
+#include "video/sdl_surface_ptr.hpp"
+#include "video/video_system.hpp"
+
+#include <SDL_image.h>
+
+bool  TuxTestTrace::s_fast   = false;
+bool  TuxTestTrace::s_nodraw = false;
+long  TuxTestTrace::s_tick   = 0;
+long  TuxTestTrace::s_ticks  = 0;
+FILE* TuxTestTrace::s_trace  = nullptr;
+bool  TuxTestTrace::s_objs   = false;
+bool  TuxTestTrace::s_nointro = false;
+bool  TuxTestTrace::s_camera = false;
+
+namespace {
+
+struct Shot { long tick; std::string path; };
+std::vector<Shot> g_shots;
+
+struct Input { long tick; Control control; bool value; };
+std::vector<Input> g_inputs;
+size_t g_next = 0;
+
+const char* dir_name(Direction d)
+{
+  switch (d) {
+    case Direction::LEFT:  return "L";
+    case Direction::RIGHT: return "R";
+    case Direction::UP:    return "U";
+    case Direction::DOWN:  return "D";
+    default:               return "-";
+  }
+}
+
+// "10:right:1,25:jump:1,40:jump:0"
+void parse_inputs(const char* s)
+{
+  std::string src(s);
+  size_t i = 0;
+  while (i < src.size()) {
+    size_t j = src.find(',', i);
+    if (j == std::string::npos) j = src.size();
+    std::string item = src.substr(i, j-i);
+    i = j + 1;
+    size_t a = item.find(':');
+    size_t b = item.find(':', a+1);
+    if (a == std::string::npos || b == std::string::npos) {
+      fprintf(stderr, "TUX_INPUT: invalid item '%s'\n", item.c_str());
+      exit(2);
+    }
+    auto control = Control_from_string(item.substr(a+1, b-a-1));
+    if (!control) {
+      fprintf(stderr, "TUX_INPUT: invalid control in '%s'\n", item.c_str());
+      exit(2);
+    }
+    g_inputs.push_back({ atol(item.substr(0,a).c_str()), *control,
+                         atoi(item.substr(b+1).c_str()) != 0 });
+  }
+}
+
+} // namespace
+
+int
+TuxTestTrace::seed(int def)
+{
+  const char* v = getenv("TUX_SEED");
+  return v ? atoi(v) : def;
+}
+
+int
+TuxTestTrace::gseed(int def)
+{
+  const char* v = getenv("TUX_GSEED");
+  return v ? atoi(v) : def;
+}
+
+void
+TuxTestTrace::init()
+{
+  const char* v;
+  s_fast   = getenv("TUX_FAST")   != nullptr;
+  s_nodraw = getenv("TUX_NODRAW") != nullptr;
+  s_objs   = getenv("TUX_TRACE_OBJS") != nullptr;
+  s_nointro = getenv("TUX_NOINTRO") != nullptr;
+  s_camera = getenv("TUX_TRACE_CAMERA") != nullptr;
+  if ((v = getenv("TUX_TICKS")))  s_ticks = atol(v);
+  if ((v = getenv("TUX_INPUT")))  parse_inputs(v);
+  if ((v = getenv("TUX_SHOT"))) {   // "tick:path,..."
+    std::string src(v);
+    size_t i = 0;
+    while (i < src.size()) {
+      size_t j = src.find(',', i);
+      if (j == std::string::npos) j = src.size();
+      std::string item = src.substr(i, j-i);
+      size_t a = item.find(':');
+      g_shots.push_back({ atol(item.substr(0,a).c_str()), item.substr(a+1) });
+      i = j + 1;
+    }
+  }
+  if ((v = getenv("TUX_TRACE"))) {
+    s_trace = (strcmp(v,"-") == 0) ? stdout : fopen(v, "w");
+    if (!s_trace) {
+      fprintf(stderr, "TUX_TRACE: cannot open '%s'\n", v);
+      exit(2);
+    }
+  }
+}
+
+// The scripted changes of the step that is about to run. `s_tick` is the
+// number of steps already done, so the first step is the tick 1.
+void
+TuxTestTrace::input(Controller& controller)
+{
+  long tick = s_tick + 1;
+  while (g_next < g_inputs.size() && g_inputs[g_next].tick <= tick) {
+    controller.set_control(g_inputs[g_next].control, g_inputs[g_next].value);
+    g_next++;
+  }
+}
+
+void
+TuxTestTrace::step()
+{
+  s_tick++;
+
+  GameSession* session = GameSession::current();
+  if (s_trace && session) {
+    Sector& sector = session->get_current_sector();
+    for (Player* p : sector.get_players()) {
+      Vector pos = p->get_pos();
+      Vector vel = p->m_physic.get_velocity();
+      fprintf(s_trace,
+        "%ld P %.9g %.9g %.9g %.9g b=%d d=%s g=%d j=%d k=%d s=%d w=%d y=%d x=%d e=%d c=%d\n",
+        s_tick, pos.x, pos.y, vel.x, vel.y,
+        static_cast<int>(p->get_bonus()), dir_name(p->m_dir),
+        p->m_on_ground_flag, p->m_jumping, p->m_duck,
+        p->m_skidding_timer.started(), p->m_swimming,
+        p->m_dying, p->m_dead, p->m_winning,
+        p->get_status().coins);
+    }
+    if (s_camera) {
+      Vector t = sector.get_camera().get_translation();
+      fprintf(s_trace, "%ld C %.9g %.9g\n", s_tick, t.x, t.y);
+    }
+    if (s_objs) {
+      for (const auto& obj : sector.get_objects()) {
+        BadGuy* b = dynamic_cast<BadGuy*>(obj.get());
+        if (!b) continue;
+        Vector pos = b->get_pos();
+        Vector vel = b->m_physic.get_velocity();
+        fprintf(s_trace, "%ld B %u %s %.9g %.9g %.9g %.9g s=%d d=%s\n",
+          s_tick, b->get_uid().get_value(), b->get_class_name().c_str(),
+          pos.x, pos.y, vel.x, vel.y,
+          static_cast<int>(b->m_state), dir_name(b->m_dir));
+      }
+    }
+  }
+
+  if (s_ticks > 0 && s_tick >= s_ticks) {
+    if (s_trace) fflush(s_trace);
+    fflush(stdout);
+    _Exit(0);
+  }
+}
+
+// The screen after the frame of the tick `s_tick` is drawn, in a PNG.
+void
+TuxTestTrace::shot(VideoSystem& video)
+{
+  for (const auto& s : g_shots) {
+    if (s.tick == s_tick) {
+      SDLSurfacePtr surface = video.make_screenshot();
+      if (surface) {
+        IMG_SavePNG(surface.get(), s.path.c_str());
+      }
+    }
+  }
+}
+
+void
+TuxTestTrace::badguy_state(const BadGuy& b, int from, int to)
+{
+  if (!s_trace) return;
+  Vector pos = b.get_pos();
+  fprintf(s_trace, "%ld E %u %s %d>%d %.9g %.9g\n",
+    s_tick + 1, b.get_uid().get_value(), b.get_class_name().c_str(),
+    from, to, pos.x, pos.y);
+}
diff --git a/src/supertux/tuxtest.hpp b/src/supertux/tuxtest.hpp
new file mode 100644
index 0000000..520fa50
--- /dev/null
+++ b/src/supertux/tuxtest.hpp
@@ -0,0 +1,36 @@
+// Test mode for the port to Atmos (ia-atmos/sdl-tux): scripted input by
+// tick, a trace, and a run with no pacing. All of it is off unless one
+// of the TUX_* environment variables is set. See tools/bench/README.md
+// in the repository of the port.
+
+#ifndef HEADER_SUPERTUX_SUPERTUX_TUXTEST_HPP
+#define HEADER_SUPERTUX_SUPERTUX_TUXTEST_HPP
+
+#include <cstdio>
+
+class Controller;
+class BadGuy;
+class VideoSystem;
+
+class TuxTestTrace
+{
+public:
+  static bool  s_fast;     // TUX_FAST: one logical step per iteration, no sleep
+  static bool  s_nodraw;   // TUX_NODRAW: no frame is drawn
+  static long  s_tick;     // logical steps since the start of the loop
+  static long  s_ticks;    // TUX_TICKS: exit after this many steps (0: never)
+  static FILE* s_trace;    // TUX_TRACE: where the trace goes (nullptr: off)
+  static bool  s_objs;     // TUX_TRACE_OBJS: the badguys too, every tick
+  static bool  s_nointro;  // TUX_NOINTRO: a level starts with no intro screen
+  static bool  s_camera;   // TUX_TRACE_CAMERA: the translation of the camera too
+
+  static void init();
+  static int  seed(int def);
+  static int  gseed(int def);   // TUX_GSEED: the seed of graphicsRandom
+  static void input(Controller& controller);   // before a logical step
+  static void step();                          // after a logical step
+  static void badguy_state(const BadGuy& b, int from, int to);
+  static void shot(VideoSystem& video);         // after a frame is drawn
+};
+
+#endif
